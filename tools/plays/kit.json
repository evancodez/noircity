{
 "about": "Lane C1's kit by real input (docs/story/seams/Z.md): BEGIN, the opening stills stepped through by clicks; the diner's first beat with its objective line; a reload, BEGIN again and the stills skipped by ESC twice; then the kit's test bed (?start=kit): a teach card shown once and not twice, game.fail from a debug hook back at the beat in under ten seconds, the fail counted. node tools/play.mjs tools/plays/kit.json",
 "url": "/?mute=1",
 "size": [1280, 800],
 "out": "shots/play/kit",
 "steps": [
  { "name": "BEGIN: the opening stills" },
  { "wait": 1500 },
  { "expect": "G.state === 'title' && G.stills.has('opening')", "label": "the title is up, the opening stills exist" },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.stills.active", "timeout": 6000 },
  { "expect": "G.stills.run.id === 'opening' && !G.scenes.current", "label": "BEGIN plays the opening stills before chapter I (no scene yet: the game held under them)" },
  { "wait": 700 },
  { "shot": "k00_panel1" },
  { "expect": "G.stills.run.panel === 0 && document.querySelectorAll('#stills .panel').length === 1", "label": "the first panel on the page" },
  { "mouse": "click" },
  { "wait": 150 },
  { "expect": "G.stills.run.panel === 1 && document.querySelectorAll('#stills .panel').length === 2", "label": "a click moves on: the second panel comes in, the first stays" },
  { "mouse": "click" },
  { "wait": 120 },
  { "expect": "G.stills.run.panel === 1", "label": "a click within 0.4 s of a panel landing does not skip it unseen" },
  { "wait": 500 },
  { "mouse": "click" },
  { "wait": 700 },
  { "shot": "k01_page" },
  { "expect": "G.stills.run.panel === 2 && document.querySelectorAll('#stills .panel').length === 3", "label": "the third panel: the page of three" },
  { "wait": 500 },
  { "key": "KeyE" },
  { "until": "!G.stills.active", "timeout": 3000 },
  { "expect": "G.stills.last.id === 'opening' && !G.stills.last.skipped && G.stills.last.panels === 3", "label": "E after the last panel ends the run (not skipped)" },
  { "until": "G.scenes.current && G.scenes.current.id === 'diner'", "timeout": 4000 },
  { "expect": "!G.keysDown.has('KeyE') && G.scenes.beat === 'settle'", "label": "the keys that moved the panels on never reach the scene" },
  { "wait": 3200 },
  { "shot": "k02_diner_objective" },
  { "expect": "G.hud.objectiveText === 'Light up. Watch the room.' && getComputedStyle(document.querySelector('#hud .kobj')).display !== 'none'", "label": "the diner's first beat: its objective line is up" },
  { "until": "G.hud.promptShown.includes('light up')", "timeout": 12000 },
  { "key": "KeyE" },
  { "until": "G.scenes.beat === 'order'", "timeout": 30000 },
  { "wait": 1300 },
  { "expect": "G.hud.objectiveText === 'Order a drink.'", "label": "the next beat: its objective strikes the last and writes itself in" },
  { "shot": "k03_objective_order" },

  { "name": "a reload, BEGIN again: the stills skipped by ESC twice" },
  { "reload": true },
  { "wait": 1500 },
  { "expect": "!document.querySelector('#title .opt[data-k=continue]').classList.contains('hidden')", "label": "a v2 save: CONTINUE offered" },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.stills.active", "timeout": 6000 },
  { "wait": 900 },
  { "key": "Escape" },
  { "wait": 350 },
  { "key": "Escape" },
  { "until": "!G.stills.active", "timeout": 2500 },
  { "expect": "G.stills.last.skipped === true && G.stills.last.secs < 2.5", "label": "ESC twice skips the run" },
  { "eval": "({ locked: document.pointerLockElement === N.renderer.domElement, pause: !document.getElementById('pausecard').classList.contains('hidden') })" },
  { "clickOn": "#pausecard", "taken": "document.pointerLockElement === N.renderer.domElement || !document.getElementById('pausecard') || document.getElementById('pausecard').classList.contains('hidden')", "retries": 3, "every": 2000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'diner'", "timeout": 6000 },
  { "expect": "G.scenes.beat === 'settle' && G.hud.objectiveText === 'Light up. Watch the room.'", "label": "after the skip: the diner from its start, its objective line" },

  { "name": "the kit's test bed: teach once, fail back to the beat" },
  { "eval": "(localStorage.removeItem('noir.save'), location.search = '?mute=1&start=kit', 1)" },
  { "wait": 2500 },
  { "until": "!!window.__noirReady && N.game.state === 'title'", "timeout": 30000 },
  { "wait": 1000 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'kit' && G.hud.kit.teachCur && !G.hud._carded", "timeout": 8000 },
  { "expect": "!G.stills.active && G.stills.last == null", "label": "a chapter picked / ?start= plays no stills" },
  { "wait": 400 },
  { "shot": "k04_teach" },
  { "expect": "G.hud.kit.teachCur.id === 'fire' && G.hud.objectiveText === 'Stop the running man.' && G.save.flags.taught.fire === true", "label": "the teach card: [LMB] fire, the objective, taught recorded in the save's flags" },
  { "wait": 800 },
  { "eval": "(window.__failT = performance.now(), G.fail({ why: 'Test.', to: 'ready' }))" },
  { "until": "G.failing && G.failing.phase === 'black'", "timeout": 3000 },
  { "wait": 300 },
  { "shot": "k05_fail_black" },
  { "until": "!G.failing", "timeout": 10000 },
  { "eval": "(window.__failMs = performance.now() - window.__failT)" },
  { "expect": "window.__failMs < 10000 && G.scenes.current.id === 'kit' && G.scenes.beat === 'ready' && !G.controller.frozen", "label": "game.fail: black, the words, back at the beat with control, under ten seconds" },
  { "expect": "G.fails('ready') === 1", "label": "the fail is counted for its beat" },
  { "wait": 600 },
  { "expect": "(G.hud.kit.shown.fire || 0) === 1 && (!G.hud.kit.teachCur || G.hud.kit.teachCur.id !== 'fire')", "label": "the teach card is not shown twice" },
  { "eval": "({ ms: Math.round(window.__failMs), shown: G.hud.kit.shown, fails: G.fails('ready') })" }
 ]
}
