{
 "about": "[O7] The night by the pad alone (?padfake=1; the keyboard and the mouse never used): X on BEGIN; the touchpad held: Tab's heat, money, car and hour; the d-pad's down: the map on the pause card (the game held), and again: closed; square at the car: in; the d-pad's right: the radio's dial; square: out; on foot the d-pad's right draws the revolver, R2 fires, the d-pad's left puts it away. node tools/play.mjs tools/plays/o7_pad.json",
 "url": "/?mute=1&padfake=1&start=city",
 "input": "pad",
 "size": [1280, 800],
 "out": "shots/o7/pad",
 "steps": [
  { "until": "G.state === 'title' && N.hud.titleShown", "timeout": 40000 },
  { "wait": 1500 },
  { "pad": { "b": ["x"], "secs": 0.12 }, "label": "the first press wakes the pad" },
  { "wait": 400 },
  { "pad": { "b": ["x"], "secs": 0.12 } },
  { "until": "G.scenes.current && G.scenes.current.id === 'city' && !G.scenes.fadeK", "timeout": 45000 },
  { "wait": 1000 },
  { "pad": { "b": ["tp"], "hold": true } },
  { "wait": 400 },
  { "expect": "!!document.querySelector('#hud .ntab.up') && G.held('Tab')", "label": "the touchpad held: Tab's lines" },
  { "pad": { "release": ["tp"] } },
  { "wait": 400 },
  { "expect": "!document.querySelector('#hud .ntab.up')", "label": "let go: gone" },
  { "pad": { "b": ["down"], "secs": 0.15 } },
  { "wait": 500 },
  { "expect": "G.night.map.open && G.night.holding", "label": "d-pad down: the map, held" },
  { "pad": { "b": ["down"], "secs": 0.15 } },
  { "wait": 500 },
  { "expect": "!G.night.map.open && !G.night.holding && !N.controller.frozen", "label": "d-pad down again: closed" },
  { "until": "G.hud.promptShown === 'E  get in' || !!G.hud.kit.teachCur", "timeout": 6000 },
  { "pad": { "b": ["sq"], "secs": 0.15 } },
  { "until": "G.city.inCar && N.pad.context() === 'drive'", "timeout": 4000 },
  { "wait": 700 },
  { "pad": { "b": ["right"], "secs": 0.15 } },
  { "wait": 400 },
  { "expect": "G.night.radio.name === 'WJZZ'", "label": "d-pad right in the car: the radio" },
  { "pad": { "b": ["sq"], "secs": 0.15 } },
  { "until": "!G.city.inCar", "timeout": 4000 },
  { "expect": "G.night.radio.cur === null", "label": "square: out, the radio gone with the door" },
  { "wait": 900 },
  { "eval": "(window.__sh = G.counters.shots || 0, 1)" },
  { "pad": { "b": ["right"], "secs": 0.15 } },
  { "wait": 500 },
  { "expect": "G.player.weapons.current === 'revolver' && N.controller.mode === 'gun'", "label": "[O7] on foot, d-pad right: the revolver drawn (the wheel)" },
  { "pad": { "b": ["r2"], "secs": 0.12 } },
  { "wait": 300 },
  { "expect": "(G.counters.shots || 0) > window.__sh", "label": "R2: fired" },
  { "pad": { "b": ["left"], "secs": 0.15 } },
  { "wait": 500 },
  { "expect": "G.player.weapons.current === 'fists' && N.controller.mode === 'walk'", "label": "d-pad left: put away" },
  { "expect": "!document.querySelector('#errlog') || !document.querySelector('#errlog').textContent.trim()", "label": "no errors in #errlog" }
 ]
}
