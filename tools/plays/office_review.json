{
 "about": "[C5] The review frames of III and IV (docs/story/review/wave-c/C5/): Ames dead at his desk; the pad shaded, its figures up; the dial with the sheet held beside it; the torn check on his desk; the take - their shadows on the frosted glass; the corridor - the lift's cage open. Real play with the stall hint checked on the way (the room points after 50 s of nothing). node tools/play.mjs tools/plays/office_review.json",
 "url": "/?mute=1&start=office.room",
 "size": [1440, 900],
 "out": "shots/play/office_review",
 "steps": [
  { "until": "G.state === 'title' && !!document.querySelector('#title .opt[data-k=begin]')", "timeout": 60000 },
  { "wait": 1500 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.scenes.current && G.scenes.current.id === 'office'", "retries": 4 },
  { "until": "G.scenes.current && G.scenes.current.id === 'office' && document.pointerLockElement === N.renderer.domElement && G.scenes.fadeK < 0.05", "timeout": 30000 },
  { "wait": 3500 },
  { "shot": "r1_ames" },
  { "name": "the stall: nothing done for 50 s - the hint light flickers on the next thing (him)" },
  { "until": "G.stage.part('office').lights.hint.on === true", "timeout": 70000 },
  { "expect": "G.scenes.ctx.flags.s.hints >= 1 && !G.scenes.ctx.flags.s.ames", "label": "a stall: the room points at him (no sentence)" },
  { "name": "the pad (its own hand rubbing it: demo)" },
  { "eval": "(localStorage.removeItem('noir.save'), location.search = '?mute=1&start=office.pad&demo=1', 1)" },
  { "wait": 2500 },
  { "until": "!!window.__noirReady && N.game.state === 'title'", "timeout": 30000 },
  { "wait": 800 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'office' && G.scenes.ctx.flags.pad && G.scenes.ctx.flags.pad.readable", "timeout": 60000 },
  { "wait": 300 },
  { "shot": "r2_pad" },
  { "name": "the dial, the sheet held up beside it" },
  { "eval": "(localStorage.removeItem('noir.save'), location.search = '?mute=1&start=office.safe', 1)" },
  { "wait": 2500 },
  { "until": "!!window.__noirReady && N.game.state === 'title'", "timeout": 30000 },
  { "wait": 800 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'office' && G.scenes.ctx.flags.safe && G.scenes.ctx.flags.safe.active && G.scenes.fadeK < 0.05", "timeout": 30000 },
  { "wait": 1500 },
  { "look": [-90, 0], "steps": 6 },
  { "wait": 400 },
  { "shot": "r3_dial" },
  { "name": "the torn check on his desk, apart" },
  { "eval": "(localStorage.removeItem('noir.save'), location.search = '?mute=1&start=office.check', 1)" },
  { "wait": 2500 },
  { "until": "!!window.__noirReady && N.game.state === 'title'", "timeout": 30000 },
  { "wait": 800 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'office' && G.scenes.fadeK < 0.05", "timeout": 30000 },
  { "eval": "(N.controller.setPose(3.0, 3.9, -Math.PI / 2, -0.73), 1)" },
  { "wait": 600 },
  { "key": "KeyE" },
  { "until": "!!N.game.puzzles.active", "timeout": 4000 },
  { "wait": 1500 },
  { "shot": "r4_check" },
  { "name": "IV: the take" },
  { "eval": "(localStorage.removeItem('noir.save'), location.search = '?mute=1&start=gunfight', 1)" },
  { "wait": 2500 },
  { "until": "!!window.__noirReady && N.game.state === 'title'", "timeout": 30000 },
  { "wait": 800 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'gunfight' && G.controller.mode === 'cutscene'", "timeout": 30000 },
  { "wait": 1400 },
  { "shot": "r5_take" },
  { "name": "IV: the corridor, the cage open" },
  { "eval": "(localStorage.removeItem('noir.save'), location.search = '?mute=1&start=gunfight.corridor', 1)" },
  { "wait": 2500 },
  { "until": "!!window.__noirReady && N.game.state === 'title'", "timeout": 30000 },
  { "wait": 800 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'gunfight' && G.scenes.beat === 'corridor' && G.scenes.fadeK < 0.05", "timeout": 30000 },
  { "eval": "(N.controller.setPose(-4.75, 0.9, 0.04, 0.02), N.controller.setMode('gun', { crouch: true }), G.health.invuln = true, 1)" },
  { "until": "!!G.scenes.ctx.flags.liftOpen", "timeout": 40000 },
  { "wait": 1200 },
  { "shot": "r6_corridor" }
 ]
}
