{
 "about": "Scene 6, The Watcher, by real input (tools/play.mjs): BEGIN at ?start=watcher; at the street window E (the slats part, he sees me, runs), E the fire escape, W down the iron and the ladder, then the chase run by W and the mouse: the straight, the two fences with SPACE held into them, the washing, the passage round the crates, the dead end and through the loose board; the car pulls away; E drive. node tools/play.mjs tools/plays/watcher.json",
 "url": "/?mute=1&start=watcher",
 "size": [
  1280,
  800
 ],
 "out": "shots/play/watcher",
 "steps": [
  {
   "wait": 1500
  },
  {
   "clickOn": "#title .opt[data-k=begin]"
  },
  {
   "name": "seen: the street window"
  },
  {
   "until": "G.scenes.current && G.scenes.current.id === 'watcher' && document.pointerLockElement === N.renderer.domElement",
   "timeout": 20000
  },
  {
   "until": "G.hud.promptShown.includes('look out')",
   "timeout": 15000
  },
  {
   "shot": "w00_window"
  },
  {
   "key": "KeyE"
  },
  {
   "wait": 900
  },
  {
   "shot": "w01_slats"
  },
  {
   "until": "G.hud.promptShown.includes('fire escape')",
   "timeout": 15000
  },
  {
   "expect": "G.scenes.ctx.flags.ran === true && ['run', 'flee', 'gone'].includes(G.scenes.ctx.flags.chase.act)",
   "label": "he saw me and ran"
  },
  {
   "expect": "G.scenes.ctx.flags.umb.state !== 'held'",
   "label": "he let the umbrella go"
  },
  {
   "shot": "w02_he_runs"
  },
  {
   "key": "KeyE"
  },
  {
   "name": "escape: down the iron"
  },
  {
   "until": "N.controller.mode === 'escape'",
   "timeout": 8000
  },
  {
   "look": [
    0,
    0
   ],
   "steps": 1
  },
  {
   "wait": 1000
  },
  {
   "down": "KeyW"
  },
  {
   "wait": 1800
  },
  {
   "shot": "w03_flight"
  },
  {
   "until": "N.controller.esc && N.controller.esc.ladderK > 0.45",
   "timeout": 20000,
   "poll": 30
  },
  {
   "shot": "w03b_ladder"
  },
  {
   "until": "N.controller.mode === 'run'",
   "timeout": 20000
  },
  {
   "up": "KeyW"
  },
  {
   "expect": "G.scenes.beat === 'escape' || G.scenes.beat === 'run'",
   "label": "down the ladder into the alley"
  },
  {
   "name": "run: the straight (W held the whole way. Few waypoints: the walker arrives within 0.4 m of each, and at 7.5 m/s on a loaded machine a slow poll can step past one and turn back for it - a man standing at a corner, who loses him. The frames of the run are shot-mode presets for the same reason)"
  },
  {
   "walk": [
    [
     2.5,
     -44.5
    ],
    [
     5.2,
     -49.6
    ]
   ],
   "timeout": 20000
  },
  {
   "expect": "G.scenes.beat === 'run' && N.controller.mode === 'run'",
   "label": "the chase is on"
  },
  {
   "name": "the fences: SPACE held down the lane (held early counts)"
  },
  {
   "down": "Space"
  },
  {
   "walk": [
    [
     28.8,
     -50.0
    ]
   ],
   "timeout": 12000
  },
  {
   "up": "Space"
  },
  {
   "expect": "N.controller.pos.x > 27",
   "label": "over both fences"
  },
  {
   "name": "the washing"
  },
  {
   "walk": [
    [
     36.2,
     -50.2
    ],
    [
     40.6,
     -54.8
    ]
   ],
   "timeout": 12000
  },
  {
   "eval": "({ gap: +(G.scenes.ctx.flags.chase.s - G.scenes.ctx.flags.chase.sp).toFixed(1), his: [+G.scenes.ctx.flags.chase.fig.pos.x.toFixed(1), +G.scenes.ctx.flags.chase.fig.pos.z.toFixed(1)], v: +G.scenes.ctx.flags.chase.v.toFixed(1) })",
   "label": "the gap coming into the washing"
  },
  {
   "walk": [
    [
     41.0,
     -61.0
    ]
   ],
   "timeout": 8000
  },
  {
   "eval": "({ gap: +(G.scenes.ctx.flags.chase.s - G.scenes.ctx.flags.chase.sp).toFixed(1), his: [+G.scenes.ctx.flags.chase.fig.pos.x.toFixed(1), +G.scenes.ctx.flags.chase.fig.pos.z.toFixed(1)], v: +G.scenes.ctx.flags.chase.v.toFixed(1) })",
   "label": "the gap through the washing (line 1 behind me)"
  },
  {
   "walk": [
    [
     41.2,
     -66.0
    ]
   ],
   "timeout": 8000
  },
  {
   "eval": "({ gap: +(G.scenes.ctx.flags.chase.s - G.scenes.ctx.flags.chase.sp).toFixed(1), his: [+G.scenes.ctx.flags.chase.fig.pos.x.toFixed(1), +G.scenes.ctx.flags.chase.fig.pos.z.toFixed(1)], v: +G.scenes.ctx.flags.chase.v.toFixed(1) })",
   "label": "the gap through the washing (line 2 behind me)"
  },
  {
   "walk": [
    [
     41.2,
     -76.0
    ],
    [
     38.6,
     -82.9
    ]
   ],
   "timeout": 12000
  },
  {
   "name": "the dog and the crates (round the fallen stacks by the gaps he leaves)"
  },
  {
   "walk": [
    [
     24.5,
     -82.9
    ],
    [
     22.8,
     -82.2
    ],
    [
     19.6,
     -82.2
    ],
    [
     16.5,
     -83.7
    ],
    [
     10.4,
     -83.7
    ],
    [
     6.6,
     -83.2
    ]
   ],
   "timeout": 20000
  },
  {
   "name": "the dead end, through the board"
  },
  {
   "walk": [
    [
     4.2,
     -86.2
    ],
    [
     4.2,
     -95.4
    ],
    [
     1.0,
     -96.65
    ],
    [
     -0.9,
     -96.9
    ]
   ],
   "timeout": 15000
  },
  {
   "until": "G.scenes.beat === 'car'",
   "timeout": 6000
  },
  {
   "expect": "G.scenes.ctx.flags.chase.lostN === 0 || JSON.stringify(G.scenes.ctx.flags.chase.lostLog)",
   "label": "never lost him"
  },
  {
   "wait": 1500
  },
  {
   "shot": "w06_tail_lamps"
  },
  {
   "name": "car: to my car's door"
  },
  {
   "walk": [
    [
     -1.2,
     -94.5
    ],
    [
     -1.4,
     -92.4
    ]
   ],
   "timeout": 10000
  },
  {
   "look": [
    260,
    60
   ],
   "steps": 8
  },
  {
   "until": "G.hud.promptShown.includes('drive')",
   "timeout": 8000
  },
  {
   "key": "KeyE"
  },
  {
   "wait": 350
  },
  {
   "shot": "w10_door"
  },
  {
   "until": "G.state === 'end' || (G.scenes.current && G.scenes.current.id !== 'watcher')",
   "timeout": 8000
  },
  {
   "expect": "G.state === 'end' || G.scenes.current.id !== 'watcher'",
   "label": "on to the tail (the next scene, or the to-be-continued card)"
  },
  {
   "eval": "({ play: +(G.scenes.playTime || 0).toFixed(1) })"
  }
 ]
}