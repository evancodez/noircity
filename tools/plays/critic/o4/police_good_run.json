{
 "about": "[O4 critic] the police by good hands, as the run plays it (no o4stay): where does a win go?",
 "url": "/?mute=1&start=o4.police",
 "size": [
  1280,
  800
 ],
 "out": "shots/critic/police_good_run",
 "steps": [
  {
   "until": "G.state === 'title' && !!document.querySelector('#title .opt[data-k=begin]')",
   "timeout": 60000
  },
  {
   "wait": 1000
  },
  {
   "clickOn": "#title .opt[data-k=begin]",
   "taken": "G.scenes.current && G.scenes.current.id === 'o4'",
   "retries": 4
  },
  {
   "until": "G.scenes.current && G.scenes.current.id === 'o4' && document.pointerLockElement === N.renderer.domElement",
   "timeout": 30000
  },
  {
   "drive": "tools/lib/o4_guns.mjs",
   "profile": "good",
   "beats": [
    "police"
   ],
   "tries": 2,
   "beatTimeout": 150,
   "check": "D.won === 1",
   "label": "the police by good hands, as the run plays it (no o4stay): where does a win go?"
  },
  {
   "wait": 4000
  },
  {
   "eval": "({t:+G.time.toFixed(1),beat:G.scenes.beat,scene:G.scenes.current&&G.scenes.current.id,obj:G.hud.objectiveText||'',err:(document.querySelector('#errlog')||{}).innerText||''})"
  }
 ]
}