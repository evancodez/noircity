{
 "about": "[O4 critic] 1v1 bad hands through by the fourth try",
 "url": "/?mute=1&o4stay=1&start=o4.brawl1",
 "size": [
  1280,
  800
 ],
 "out": "shots/critic/b1v1_bad",
 "steps": [
  {
   "until": "G.state === 'title' && !!document.querySelector('#title .opt[data-k=begin]')",
   "timeout": 60000
  },
  {
   "wait": 1000
  },
  {
   "clickOn": "#title .opt[data-k=begin]",
   "taken": "G.scenes.current && G.scenes.current.id === 'o4'",
   "retries": 4
  },
  {
   "until": "G.scenes.beat === 'brawl1' && G.crowd.active && !G.failing",
   "timeout": 30000
  },
  {
   "eval": "(G.o4stay = true)"
  },
  {
   "drive": "tools/lib/o4_brawl.mjs",
   "profile": "bad",
   "beat": "brawl1",
   "tries": 4,
   "wins": 1,
   "timeout": 400000,
   "shots": 0,
   "check": "D.wins>=1",
   "label": "1v1 bad hands through by the fourth try"
  }
 ]
}