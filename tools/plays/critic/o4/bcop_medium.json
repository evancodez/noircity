{
 "about": "[O4 critic] the cop, medium",
 "url": "/?mute=1&o4stay=1&start=o4.cop",
 "size": [
  1280,
  800
 ],
 "out": "shots/critic/bcop_medium",
 "steps": [
  {
   "until": "G.state === 'title' && !!document.querySelector('#title .opt[data-k=begin]')",
   "timeout": 60000
  },
  {
   "wait": 1000
  },
  {
   "clickOn": "#title .opt[data-k=begin]",
   "taken": "G.scenes.current && G.scenes.current.id === 'o4'",
   "retries": 4
  },
  {
   "until": "G.scenes.beat === 'cop' && G.crowd.active && !G.failing",
   "timeout": 30000
  },
  {
   "eval": "(G.o4stay = true)"
  },
  {
   "drive": "tools/lib/o4_brawl.mjs",
   "profile": "medium",
   "beat": "cop",
   "tries": 3,
   "wins": 1,
   "timeout": 400000,
   "shots": 0,
   "check": "D.wins>=1",
   "label": "the cop, medium"
  }
 ]
}