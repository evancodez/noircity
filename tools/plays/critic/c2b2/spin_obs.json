  },
  {
   "eval": "(window.T0 = G.time, window.YT = [], window.YTF = () => { for (const [h, ai] of G.ais) if (h.alive) { const S = ai.brain && ai.brain.S; YT.push([+(G.time - T0).toFixed(3), h.slot, +h.yaw.toFixed(3), +h.pos.x.toFixed(2), +h.pos.z.toFixed(2), S && S.state]); } }, G.scripts.push(YTF), window.OBS = 0, window.R0 = N.pipeline.render.bind(N.pipeline), N.pipeline.render = (s, c, t) => { const h = [...G.ais.keys()].find((q) => q.slot === OBS && q.alive); if (!h) return R0(s, c, t); const p = c.position.clone(), q = c.quaternion.clone(); c.position.set(h.pos.x + 0.15, 2.55, h.pos.z - 1.5); c.lookAt(h.pos.x, 0.7, h.pos.z + 0.2); c.updateMatrixWorld(); R0(s, c, t); c.position.copy(p); c.quaternion.copy(q); c.updateMatrixWorld(); }, 1)"
  },
