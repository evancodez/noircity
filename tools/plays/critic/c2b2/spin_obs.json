  {
   "wait": 1500
  },
  {
   "clickOn": "#title .opt[data-k=begin]",
   "taken": "G.scenes.current && G.scenes.current.id === 'guns'",
   "retries": 4
  },
  {
   "until": "G.scenes.current && G.scenes.current.id === 'guns' && G.scenes.beat === 'two_ways' && !G.scenes.trans && G.ais.size > 0",
