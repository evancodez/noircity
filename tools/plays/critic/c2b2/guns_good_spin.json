{
 "about": "C2b critic copy of guns_good with the turn counter read at the end",
 "url": "/?mute=1&start=guns.door",
 "size": [
  1280,
  800
 ],
 "out": "shots/critic/c2b2/guns_good",
 "steps": [
  {
   "name": "the title, BEGIN at the test bed"
  },
  {
   "until": "G.state === 'title' && !!document.querySelector('#title .opt[data-k=begin]')",
   "timeout": 60000
  },
  {
   "wait": 1500
  },
  {
   "clickOn": "#title .opt[data-k=begin]",
   "taken": "G.scenes.current && G.scenes.current.id === 'guns'",
   "retries": 4
  },
  {
   "until": "G.scenes.current && G.scenes.current.id === 'guns' && document.pointerLockElement === N.renderer.domElement",
   "timeout": 30000
  },
  {
   "name": "every contest, played well"
  },
  {
   "drive": "tools/lib/c2_guns.mjs",
   "profile": "good",
   "tries": 3,
   "beatTimeout": 150,
   "beats": [
    "door",
    "two_ways",
    "pin",
    "rush",
    "street",
    "street_rev"
   ],
   "check": "D.wonFirst === 6",
   "label": "the good player wins every contest on the first try"
  },
  {
   "eval": "(N.game.guns.events || []).filter((e) => e.what === 'down' || e.what === 'flank').map((e) => e.what + ' ' + (e.why || e.at))"
  },
  {
   "eval": "(() => { const S = G.guns.spin; return S ? { secDeg: Math.round(S.sec * 57.3), revDeg: Math.round(S.rev * 57.3), turnDeg: Math.round(S.turn * 57.3), who: S.who, whoTurn: S.whoTurn } : null; })()"
  },
  {
   "eval": "G.guns.events.filter((e) => e.what === 'spin')"
  },
  {
   "eval": "G.guns.events.filter((e) => e.what === 'down').map((e) => e.why)"
  }
 ]
}