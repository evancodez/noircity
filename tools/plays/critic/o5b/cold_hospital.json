   "eval": "(window.__log=[],window.__lp={},setInterval(()=>{const t=(performance.now()/1000).toFixed(1);const p=G.hud.promptShown,m=document.querySelector('#hud .msg').textContent,o=G.hud.objectiveText;if(p!==__lp.p)__log.push(t+' P['+p+']');if(m!==__lp.m&&m)__log.push(t+' M['+m+']');if(o!==__lp.o)__log.push(t+' O['+o+']');__lp={p,m,o}},50),window.__E=[],addEventListener('keydown',e=>{if(e.code==='KeyE'){const d=G.city.places.byId.get('hospital');const L=d&&d.live;const doors=L?[...(L.street||[]),...(L.doors||[])]:[];const a0=doors.map(x=>x&&x.angle);const t0=performance.now();let n=0;const f=()=>{n++;const k=doors.findIndex((x,i)=>x&&Math.abs(x.angle-a0[i])>1e-4);if(k>=0){__E.push('E->door '+k+' '+(performance.now()-t0).toFixed(0)+'ms');return}if(n<60)requestAnimationFrame(f);else __E.push('E: no door moved in 60 frames')};requestAnimationFrame(f)}},true),document.getElementById('hud').innerText.replace(/\\s+/g,' ').slice(0,300))"
