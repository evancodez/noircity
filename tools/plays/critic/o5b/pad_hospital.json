{
 "about": "[O5b critic] the pad alone (?padfake=1) at the hospital: BEGIN by cross, the street door (square), in by the stick, the ward's swing doors by the stick, a free bed (square: sleep), the black and up; no key or mouse.",
 "url": "/?mute=1&start=city&padfake=1",
 "input": "pad",
 "size": [1280, 800],
 "out": "shots/critic_o5b/pad",
 "steps": [
  { "until": "G.state === 'title' && !document.getElementById('title').classList.contains('hidden')", "timeout": 60000 },
  { "wait": 1500 },
  { "pad": { "b": ["x"], "secs": 0.12 } },
  { "wait": 400 },
  { "pad": { "b": ["x"], "secs": 0.12 } },
  { "until": "G.scenes.current && G.scenes.current.id === 'city' && G.scenes.fadeK < 0.05", "timeout": 60000 },
  { "wait": 1000 },
  { "eval": "(() => { const s = G.city.places.byId.get('hospital'), F = s.frame; const p = F.w(0, 1.6); G.stage.part('stream').warmAround(p.x, p.z); N.controller.setPose(p.x, p.z, F.yaw(0), -0.05); window.__keys=0; addEventListener('keydown',()=>__keys++,true); addEventListener('mousedown',()=>__keys++,true); return 1; })()" },
  { "wait": 2500 },
  { "name": "the door", "expect": "/go in/.test(G.hud.promptShown)" },
  { "pad": { "b": ["sq"], "secs": 0.35 } },
  { "wait": 700 },
  { "name": "the door opens", "expect": "!G.city.places.byId.get('hospital').live.street[0].shut" },
  { "pad": { "a": [0, -1, 0, 0], "secs": 4.6 } },
  { "wait": 400 },
  { "eval": "'at '+JSON.stringify(G.city.places.byId.get('hospital').frame.l(N.controller.pos.x,N.controller.pos.z))+' in '+(G.city.places.inside&&G.city.places.inside.id)" },
  { "pad": { "a": [0, -1, 0, 0], "secs": 2.0 } },
  { "eval": "'at '+JSON.stringify(G.city.places.byId.get('hospital').frame.l(N.controller.pos.x,N.controller.pos.z))" },
  { "pad": { "a": [0, 0, 0.55, 0], "secs": 0.9 } },
  { "wait": 500 },
  { "eval": "'prompt '+G.hud.promptShown" },
  { "until": "/sleep|lie/.test(G.hud.promptShown)", "timeout": 4000, "label": "a bed's prompt by the pad's look" },
  { "pad": { "b": ["sq"], "secs": 0.35 } },
  { "wait": 5500 },
  { "eval": "'after: keys '+__keys+' msg '+document.querySelector('#hud .msg').textContent+' frozen '+N.controller.frozen" }
 ]
}
