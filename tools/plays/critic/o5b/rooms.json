   "look": "(()=>{const d=G.city.places.byId.get('pieroffice').door;const C=N.controller;let dy=Math.atan2(d.nx,d.nz)-C.yaw;dy=Math.atan2(Math.sin(dy),Math.cos(dy));return [-dy/C.sensitivity,0]})()",
   "steps": 4
  },
  {
   "eval": "(window.__arm='pieroffice','pieroffice prompt: '+G.hud.promptShown+' live '+!!G.city.places.byId.get('pieroffice').live)"
  },
  {
   "key": "KeyE",
   "hold": 70
  },
  {
   "wait": 900
  },
  {
   "walk": "(()=>{const F=G.city.places.byId.get('pieroffice').frame;const p=F.w(0,-2.4);return [[p.x,p.z]]})()",
   "timeout": 12000
  },
  {
   "wait": 600
  },
  {
   "shot": "pieroffice"
  },
  {
   "walk": "(()=>{const F=G.city.places.byId.get('pieroffice').frame;const p=F.w(0.3,-14);return [[p.x,p.z]]})()",
   "timeout": 7000,
   "into": true
  },
  {
   "eval": "(()=>{const s=G.city.places.byId.get('pieroffice');const l=s.frame.l(N.controller.pos.x,N.controller.pos.z);return 'pieroffice into: stopped at '+l.x.toFixed(1)+','+l.z.toFixed(1)+' prompt '+G.hud.promptShown+' lat '+JSON.stringify(__lat['pieroffice'])})()"
  }
 ]
}