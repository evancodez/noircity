{
 "about": "[O5b critic] the rooms told apart: each place's street door from 7 m out, walked to, E (the first open timed: the key to the leaf's first move), 2.4 m in, a frame; then walked straight in until something stops me.",
 "url": "/?mute=1&start=city",
 "size": [
  1280,
  800
 ],
 "out": "shots/critic_o5b/rooms",
 "steps": [
  {
   "wait": 1500
  },
  {
   "clickOn": "#title .opt[data-k=begin]",
   "taken": "G.state !== 'title'",
   "retries": 5,
   "every": 4000
  },
  {
   "until": "G.scenes.current && G.scenes.current.id === 'city' && G.scenes.fadeK < 0.05",
   "timeout": 30000
  },
  {
   "look": [
    0,
    0
   ],
   "steps": 1
  },
  {
   "eval": "(N.controller.pitch=0,window.__lat={},window.__arm=null,addEventListener('keydown',e=>{if(e.code!=='KeyE'||!window.__arm)return;const s=G.city.places.byId.get(__arm);const L=s&&s.live;const D=L&&L.street&&L.street[0];if(!D){__lat[__arm]='no live door';return}const a0=D.angle,t0=performance.now();let last=t0,mx=0,n=0,id=__arm;__arm=null;const f=()=>{const t=performance.now();mx=Math.max(mx,t-last);last=t;n++;if(Math.abs(D.angle-a0)>1e-4){__lat[id]={lat:+(t-t0).toFixed(0),warm:L.warm};setTimeout(()=>{},0);return}if(n<90)requestAnimationFrame(f);else __lat[id]='no move'};requestAnimationFrame(f)},true),1)"
  },
  {
   "eval": "(()=>{const s=G.city.places.byId.get('diner');if(!s)return 'none diner';const d=s.door;const x=d.x+d.nx*7,z=d.z+d.nz*7;G.stage.part('stream').warmAround(x,z);N.controller.setPose(x,z,Math.atan2(d.nx,d.nz),0);G.stage.part('bounds').navAround(x,z,30);return 'diner live '+!!s.live})()"
  },
  {
   "wait": 1200
  },
  {
   "walk": "(()=>{const d=G.city.places.byId.get('diner').door;return [[d.x+d.nx*1.3,d.z+d.nz*1.3]]})()",
   "timeout": 20000
  },
  {
   "look": "(()=>{const d=G.city.places.byId.get('diner').door;const C=N.controller;let dy=Math.atan2(d.nx,d.nz)-C.yaw;dy=Math.atan2(Math.sin(dy),Math.cos(dy));return [-dy/C.sensitivity,0]})()",
   "steps": 4
  },
  {
   "eval": "(window.__arm='diner','diner prompt: '+G.hud.promptShown+' live '+!!G.city.places.byId.get('diner').live)"
  },
