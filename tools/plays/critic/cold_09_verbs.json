{
 "about": "[cold play] The other verbs a stranger tries in the first minutes, on foot at the Grand Ave start: the mouse buttons (fire / jab), R, F, C, Tab, Shift-run, SPACE, Q, 1 and 2, then Escape (the pause card) - what the city does with each.",
 "url": "/?mute=1&start=city",
 "size": [1440, 900],
 "out": "shots/cold/09",
 "steps": [
  { "wait": 2500 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'city' && G.scenes.fadeK < 0.05", "timeout": 25000 },
  { "look": [1, 0], "steps": 1 },
  { "eval": "(N.controller.pitch = -0.04, 1)" },
  { "look": [-748, 0], "steps": 6 },
  { "wait": 400 },
  { "mouse": "click", "button": "left" },
  { "wait": 300 },
  { "shot": "00_lmb" },
  { "mouse": "click", "button": "right", "hold": 400 },
  { "eval": "JSON.stringify({hands: G.player.hands.current || G.player.hands.kind || null, txt: document.body.innerText.replace(/\\s+/g,' ').slice(0,80)})" },
  { "key": "Digit1", "hold": 80 }, { "wait": 300 },
  { "key": "Digit2", "hold": 80 }, { "wait": 300 },
  { "key": "KeyR", "hold": 80 }, { "wait": 300 },
  { "key": "KeyF", "hold": 80 }, { "wait": 300 },
  { "key": "KeyQ", "hold": 80 }, { "wait": 300 },
  { "eval": "JSON.stringify({hands: G.player.hands.current || G.player.hands.kind || null, txt: document.body.innerText.replace(/\\s+/g,' ').slice(0,80)})" },
  { "shot": "01_after_keys" },
  { "down": "Tab" }, { "wait": 600 },
  { "shot": "02_tab" },
  { "up": "Tab" },
  { "down": "ShiftLeft" }, { "down": "KeyW" }, { "wait": 2500 },
  { "eval": "JSON.stringify({pos: [+N.controller.pos.x.toFixed(1), +N.controller.pos.z.toFixed(1)]})" },
  { "key": "Space", "hold": 100 }, { "wait": 200 },
  { "shot": "03_run_jump" },
  { "up": "KeyW" }, { "up": "ShiftLeft" },
  { "key": "KeyC", "hold": 80 }, { "wait": 400 },
  { "shot": "04_crouch" },
  { "key": "Escape", "hold": 80 }, { "wait": 900 },
  { "shot": "05_pause" },
  { "eval": "JSON.stringify({state: G.state, txt: document.body.innerText.replace(/\\s+/g,' ').slice(0,300)})" }
 ]
}
