  { "wait": 800 },
  { "drive": "tools/plays/critic/o1c/approach.mjs", "targets": [
    { "name": "a dustbin", "find": "__T('bin')" },
    { "name": "a sandwich board", "find": "__T('board')" },
    { "name": "crates", "find": "__T('crates')" },
    { "name": "a hydrant", "find": "__T('hydrant')" },
    { "name": "a lamp post", "find": "__T('lamp')" },
    { "name": "a bench", "find": "__T('bench')" },
    { "name": "a bench, C held", "find": "__T('bench', 1)", "kick": true },
    { "name": "shop glass", "find": "__face('glass')", "back": 2.5 },
    { "name": "a wall", "find": "__face('wall')" },
    { "name": "a door", "find": "__face('door')" },
    { "name": "a parked car", "find": "__car()", "shot": "car_hit", "back": 2.2 },
    { "name": "a bottle on a step", "find": "__bottle()", "pitch": -0.45 }
   ], "check": "true" },
  { "eval": "JSON.stringify({heat: G.police && G.police.heat, mode: N.controller.mode, txt: document.body.innerText.replace(/\\s+/g,' ').slice(0,200)})" }
 ]
