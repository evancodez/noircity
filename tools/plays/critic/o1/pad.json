{
 "about": "[O1] The free roam by the pad alone (the fake pad; the keyboard and the mouse never used): X on BEGIN; square at the car: in; R2: it drives up Grand Ave; L2: it stops; square: out; d-pad down: the map, and again: closed; the left stick: a walk. node tools/play.mjs tools/plays/o1_pad.json",
 "url": "/?mute=1&padfake=1&start=city",
 "input": "pad",
 "size": [1280, 800],
 "out": "shots/critic_o1/pad",
 "steps": [
  { "until": "G.state === 'title' && N.hud.titleShown", "timeout": 40000 },
  { "wait": 1500 },
  { "pad": { "b": ["x"], "secs": 0.12 }, "label": "the first press wakes the pad" },
  { "wait": 400 },
  { "pad": { "b": ["x"], "secs": 0.12 } },
  { "until": "G.scenes.current && G.scenes.current.id === 'city' && !G.scenes.fadeK", "timeout": 45000 },
  { "wait": 1000 },
  { "until": "G.hud.promptShown === 'E  get in'", "timeout": 4000 },
  { "pad": { "b": ["sq"], "secs": 0.15 } },
  { "until": "G.city.inCar && N.pad.context() === 'drive'", "timeout": 4000 },
  { "wait": 700 },
  { "pad": { "v": { "r2": 0.8 }, "hold": true } },
  { "wait": 3000 },
  { "expect": "G.city.car.speed > 4", "label": "R2: the car drives" },
  { "pad": { "v": { "r2": 0, "l2": 1 }, "hold": true } },
  { "until": "Math.abs(G.city.car.speed) < 0.5", "timeout": 6000 },
  { "pad": { "v": { "l2": 0 } } },
  { "wait": 900 },
  { "pad": { "b": ["sq"], "secs": 0.15 } },
  { "until": "!G.city.inCar", "timeout": 3000 },
  { "wait": 700 },
  { "pad": { "b": ["down"], "secs": 0.15 } },
  { "wait": 400 },
  { "expect": "G.city.map.isOpen", "label": "d-pad down: the map" },
  { "shot": "p00_map" },
  { "pad": { "b": ["down"], "secs": 0.15 } },
  { "wait": 400 },
  { "expect": "!G.city.map.isOpen", "label": "d-pad down again: closed" },
  { "eval": "(window.__p0 = [N.controller.pos.x, N.controller.pos.z], 1)" },
  { "pad": { "a": [0, -1, 0, 0], "secs": 1.2 } },
  { "wait": 300 },
  { "expect": "Math.hypot(N.controller.pos.x - window.__p0[0], N.controller.pos.z - window.__p0[1]) > 1", "label": "the left stick: a walk" }
 ]
}
