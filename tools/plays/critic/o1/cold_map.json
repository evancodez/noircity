{
 "about": "[O1 critic] the map by M, closed by M, ESC pause; the keys a first-timer tries.",
 "url": "/?mute=1&start=city",
 "size": [1280, 800],
 "out": "shots/critic_o1/map",
 "steps": [
  { "wait": 2000 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'city' && G.scenes.fadeK < 0.05", "timeout": 20000 },
  { "wait": 800 },
  { "key": "KeyM", "hold": 60 },
  { "wait": 120 }, { "shot": "00_m_120ms" },
  { "wait": 800 }, { "shot": "01_map" },
  { "eval": "JSON.stringify({state:G.state, map:G.city.map && G.city.map.open, t:[...document.querySelectorAll('body *')].filter(e=>e.offsetParent&&e.children.length===0&&e.innerText&&e.innerText.trim()).map(e=>e.innerText.trim().slice(0,40)).join(' | ')})" },
  { "down": "KeyW" }, { "wait": 800 }, { "up": "KeyW" },
  { "eval": "JSON.stringify({p:G.camera.position.toArray().map(v=>+v.toFixed(1))})" },
  { "key": "KeyM", "hold": 60 },
  { "wait": 600 }, { "shot": "02_closed" },
  { "eval": "JSON.stringify({state:G.state, map:G.city.map && G.city.map.open})" },
  { "key": "Tab", "hold": 60 }, { "wait": 400 }, { "shot": "03_tab" },
  { "key": "Escape", "hold": 60 }, { "wait": 700 }, { "shot": "04_esc" },
  { "eval": "JSON.stringify({state:G.state, t:[...document.querySelectorAll('body *')].filter(e=>e.offsetParent&&e.children.length===0&&e.innerText&&e.innerText.trim()).map(e=>e.innerText.trim().slice(0,40)).join(' | ')})" },
  { "key": "KeyM", "hold": 60 }, { "wait": 700 }, { "shot": "05_esc_m" },
  { "eval": "JSON.stringify({state:G.state, map:G.city.map && G.city.map.open, muted:G.muted})" }
 ]
}
