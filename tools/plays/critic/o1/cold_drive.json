{
 "about": "[O1 critic] the first drive by hand: E at the car, W, a turn, into whatever is ahead; what the screen says; then out of the car.",
 "url": "/?mute=1&start=city",
 "size": [1280, 800],
 "out": "shots/critic_o1/drive",
 "steps": [
  { "wait": 2000 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'city' && G.scenes.fadeK < 0.05", "timeout": 20000 },
  { "wait": 1000 },
  { "eval": "JSON.stringify({p:G.camera.position.toArray().map(v=>+v.toFixed(1)), car:G.city.car.pos.toArray().map(v=>+v.toFixed(1)), yaw:+G.city.car.yaw.toFixed(2)})" },
  { "key": "KeyE", "hold": 80 },
  { "wait": 300 }, { "shot": "00_e_03" },
  { "wait": 900 }, { "shot": "01_in" },
  { "eval": "JSON.stringify({inCar:G.city.inCar, t:[...document.querySelectorAll('body *')].filter(e=>e.offsetParent&&e.children.length===0&&e.innerText&&e.innerText.trim()).map(e=>e.innerText.trim().slice(0,40)).join(' | ')})" },
  { "down": "KeyW" },
  { "wait": 1500 }, { "shot": "02_w15" },
  { "eval": "JSON.stringify({v:+(G.city.car.speed*3.6).toFixed(0), pos:[+G.city.car.pos.x.toFixed(0),+G.city.car.pos.z.toFixed(0)], d:(G.stage.part('city').C.cellAt(G.city.car.pos.x,G.city.car.pos.z)||{}).district})" },
  { "wait": 2500 }, { "shot": "03_w40" },
  { "eval": "JSON.stringify({v:+(G.city.car.speed*3.6).toFixed(0), pos:[+G.city.car.pos.x.toFixed(0),+G.city.car.pos.z.toFixed(0)], cr:G.city.car.stats.crashes, sc:G.city.car.stats.scrapes})" },
  { "down": "KeyD" }, { "wait": 700 }, { "up": "KeyD" },
  { "wait": 2500 }, { "shot": "04_after_turn" },
  { "eval": "JSON.stringify({v:+(G.city.car.speed*3.6).toFixed(0), pos:[+G.city.car.pos.x.toFixed(0),+G.city.car.pos.z.toFixed(0)], cr:G.city.car.stats.crashes, sc:G.city.car.stats.scrapes})" },
  { "wait": 4000 }, { "shot": "05_w_more" },
  { "eval": "JSON.stringify({v:+(G.city.car.speed*3.6).toFixed(0), pos:[+G.city.car.pos.x.toFixed(0),+G.city.car.pos.z.toFixed(0)], cr:G.city.car.stats.crashes, sc:G.city.car.stats.scrapes, health:G.city.car.health, dmg:G.city.car.damage})" },
  { "up": "KeyW" },
  { "down": "Space" }, { "wait": 1200 }, { "up": "Space" },
  { "wait": 800 },
  { "eval": "JSON.stringify({v:+(G.city.car.speed*3.6).toFixed(1)})" },
  { "key": "KeyE", "hold": 80 },
  { "wait": 1200 }, { "shot": "06_out" },
  { "eval": "JSON.stringify({inCar:G.city.inCar, p:G.camera.position.toArray().map(v=>+v.toFixed(1)), t:[...document.querySelectorAll('body *')].filter(e=>e.offsetParent&&e.children.length===0&&e.innerText&&e.innerText.trim()).map(e=>e.innerText.trim().slice(0,40)).join(' | ')})" }
 ]
}
