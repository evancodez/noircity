{
 "about": "[O5 critic] the Orpheum's house: through the lobby to its double door by input, E, in, to the seat on the aisle, E (the reel), up, out the way I came",
 "url": "/?mute=1&start=city",
 "size": [1280, 800],
 "out": "shots/critic_o5/thh",
 "steps": [
  { "wait": 1500 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'city' && G.scenes.fadeK < 0.05", "timeout": 25000 },
  { "look": [2, 0], "steps": 1 },
  { "look": "[0, Math.round((N.controller.pitch + 0.04) / N.controller.sensitivity)]", "steps": 4 },
  { "walk": [[-124, 28], [-127, 14], [-131.4, 13.9]], "timeout": 20000 },
  { "key": "KeyE", "hold": 70 }, { "wait": 700 },
  { "walk": "(()=>{const F=G.city.places.byId.get('theatre1').frame;return [[0,-2.2],[0.6,-5.6]].map(([x,z])=>{const p=F.w(x,z);return [p.x,p.z]})})()", "timeout": 10000 },
  { "eval": "(()=>{const s=G.city.places.byId.get('theatre1'),d=s.live.K.doors[0],F=s.frame,l=F.l(d.centre.x,d.centre.z);return 'house door centre local '+l.x.toFixed(2)+','+l.z.toFixed(2)+' prompt:'+G.hud.promptShown})()" },
  { "look": "[0, Math.round((N.controller.pitch + 0.0) / N.controller.sensitivity)]", "steps": 3 },
  { "wait": 300 }, { "shot": "housedoor" },
  { "eval": "'prompt:'+G.hud.promptShown" },
  { "key": "KeyE", "hold": 70 }, { "wait": 900 },
  { "eval": "(()=>{const d=G.city.places.byId.get('theatre1').live.K.doors[0];return 'open01 '+(d.open01??'?')+' leaves '+d.leaves.length})()" },
  { "walk": "(()=>{const s=G.city.places.byId.get('theatre1'),F=s.frame,S=s.live.K.seats[0];return [[0.6,-8.5],[S.standAt.x,S.standAt.z]].map(([x,z])=>{const p=F.w(x,z);return [p.x,p.z]})})()", "timeout": 15000, "stop": false },
  { "wait": 300 }, { "shot": "house" },
  { "eval": "(()=>{const s=G.city.places.byId.get('theatre1'),F=s.frame,S=s.live.K.seats[0],a=F.v(S.at[0],S.at[1],S.at[2]);return 'seat at '+a.x.toFixed(1)+','+a.z.toFixed(1)+' me '+N.controller.pos.x.toFixed(1)+','+N.controller.pos.z.toFixed(1)+' prompt:'+G.hud.promptShown})()" },
  { "look": "(()=>{const s=G.city.places.byId.get('theatre1'),F=s.frame,S=s.live.K.seats[0],a=F.v(S.at[0],S.at[1],S.at[2]);const dx=a.x-G.eye.x,dz=a.z-G.eye.z,dy=a.y-G.eye.y;const w=Math.atan2(-dx,-dz);let e=Math.atan2(Math.sin(w-N.controller.yaw),Math.cos(w-N.controller.yaw));const p=Math.atan2(dy,Math.hypot(dx,dz));return [Math.round(-e/N.controller.sensitivity),Math.round(-(p-N.controller.pitch)/N.controller.sensitivity)]})()", "steps": 6 },
  { "wait": 400 },
  { "eval": "'prompt:'+G.hud.promptShown" },
  { "key": "KeyE", "hold": 70 }, { "wait": 1000 }, { "shot": "sat" },
  { "wait": 2500 }, { "shot": "reel" },
  { "eval": "'seat:'+!!G.city.places.seat+' stills:'+(G.stills&&G.stills.active)+' state '+G.state+' hud:'+document.getElementById('hud').innerText.replace(/\\s+/g,' ').slice(0,200)" },
  { "key": "KeyE", "hold": 70 }, { "wait": 1500 },
  { "eval": "'after E: seat:'+!!G.city.places.seat+' state '+G.state+' hud:'+document.getElementById('hud').innerText.replace(/\\s+/g,' ').slice(0,200)" },
  { "key": "KeyE", "hold": 70 }, { "wait": 1500 },
  { "eval": "'after E2: seat:'+!!G.city.places.seat+' state '+G.state" },
  { "shot": "up" }
 ]
}
