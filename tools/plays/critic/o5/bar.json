{
 "about": "[O5 critic] the Tenements bar: in by its door, every usable thing poked (the stools sat on), a whiskey at a stool, a fist at the barman (LMB), walking into the drunks, then their fight (brought forward: a set-up) and stepping into it with good hands",
 "url": "/?mute=1&start=city",
 "size": [1280, 800],
 "out": "shots/critic_o5/bar",
 "steps": [
  { "wait": 1500 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'city' && G.scenes.fadeK < 0.05", "timeout": 25000 },
  { "eval": "(() => { const s = G.city.places.byId.get('bar1'), d = s.door; const x = d.x + d.nx * 3, z = d.z + d.nz * 3; G.stage.part('stream').warmAround(x, z); N.controller.setPose(x, z, Math.atan2(d.nx, d.nz), -0.05); window.__crimes = []; G.on('crime', (e) => window.__crimes.push(e.kind)); return 1; })()" },
  { "wait": 2500 },
  { "key": "KeyE", "hold": 70 }, { "wait": 700 },
  { "walk": "(()=>{const F=G.city.places.byId.get('bar1').frame;return [[0,-1.8],[0,-3]].map(([x,z])=>{const p=F.w(x,z);return [p.x,p.z]})})()", "timeout": 10000, "stop": false },
  { "shot": "in" },
  { "drive": "tools/plays/critic/o5/poke.mjs", "site": "bar1", "sitMs": 800 },
  { "eval": "(()=>{const s=G.city.places.byId.get('bar1');return 'cast: '+s.live.cast.map(c=>c.name.replace('bar1_','')+'@'+c.pos.x.toFixed(1)+','+c.pos.z.toFixed(1)).join(' ')+' | matchbooks '+JSON.stringify(G.save.matchbooks||null)})()" },
  { "walk": "(()=>{const s=G.city.places.byId.get('bar1'),c=s.live.cast.find(c=>/barman/.test(c.name)),e=G.eye,dx=e.x-c.pos.x,dz=e.z-c.pos.z,L=Math.hypot(dx,dz);return [[c.pos.x+dx/L*1.6,c.pos.z+dz/L*1.6]]})()", "timeout": 12000, "stop": false },
  { "look": "(()=>{const c=G.city.places.byId.get('bar1').live.cast.find(c=>/barman/.test(c.name)),a={x:c.pos.x,y:1.5,z:c.pos.z};const dx=a.x-G.eye.x,dz=a.z-G.eye.z,dy=a.y-G.eye.y;const w=Math.atan2(-dx,-dz);const e=Math.atan2(Math.sin(w-N.controller.yaw),Math.cos(w-N.controller.yaw));const p=Math.atan2(dy,Math.hypot(dx,dz));return [Math.round(-e/N.controller.sensitivity),Math.round(-(p-N.controller.pitch)/N.controller.sensitivity)]})()", "steps": 6 },
  { "eval": "'at the barman: prompt '+G.hud.promptShown+' mode '+N.controller.mode+' hands '+G.player.hands.current" },
  { "mouse": "click", "button": "left" }, { "wait": 300 }, { "mouse": "click", "button": "left" }, { "wait": 300 }, { "mouse": "click", "button": "right" }, { "wait": 800 },
  { "shot": "barman_lmb" },
  { "eval": "'after LMB x2 RMB at the barman: crimes '+window.__crimes.join(',')+' brawl '+G.brawl.active+' hud '+document.getElementById('hud').innerText.replace(/\\s+/g,' ').slice(0,100)" },
  { "eval": "(G.city.places.byId.get('bar1').live.run.__forceNext = true, 'the fight brought forward')" },
  { "wait": 2500 },
  { "eval": "'fight? '+document.getElementById('hud').innerText.replace(/\\s+/g,' ').slice(0,100)+' crimes '+window.__crimes.join(',')" },
  { "walk": "(()=>{const s=G.city.places.byId.get('bar1'),c=s.live.cast.find(c=>/drunkA/.test(c.name)),e=G.eye,dx=e.x-c.pos.x,dz=e.z-c.pos.z,L=Math.hypot(dx,dz);return [[c.pos.x+dx/L*1.5,c.pos.z+dz/L*1.5]]})()", "timeout": 12000, "stop": false },
  { "look": "(()=>{const c=G.city.places.byId.get('bar1').live.cast.find(c=>/drunkA/.test(c.name)),a={x:c.pos.x,y:1.4,z:c.pos.z};const dx=a.x-G.eye.x,dz=a.z-G.eye.z,dy=a.y-G.eye.y;const w=Math.atan2(-dx,-dz);const e=Math.atan2(Math.sin(w-N.controller.yaw),Math.cos(w-N.controller.yaw));const p=Math.atan2(dy,Math.hypot(dx,dz));return [Math.round(-e/N.controller.sensitivity),Math.round(-(p-N.controller.pitch)/N.controller.sensitivity)]})()", "steps": 6 },
  { "shot": "fight" },
  { "eval": "'at the fight: prompt '+G.hud.promptShown" },
  { "key": "KeyE", "hold": 70 },
  { "until": "G.brawl.active", "timeout": 4000, "stop": false },
  { "drive": "tools/plays/critic/c4_bot.mjs", "profile": "good", "timeout": 200000, "shots": 0 },
  { "wait": 2500 },
  { "eval": "'after the bar fight: brawl '+G.brawl.active+' won '+(G.brawl.stats&&G.brawl.stats.won)+' mode '+N.controller.mode+' crimes '+window.__crimes.join(',')+' hud '+document.getElementById('hud').innerText.replace(/\\s+/g,' ').slice(0,100)" },
  { "shot": "after" }
 ]
}
