  },
  {
   "pad": {
    "b": [
     "x"
    ],
    "secs": 0.12
   }
  },
  {
   "until": "G.scenes.current && G.scenes.current.id === 'shootout'",
   "timeout": 60000
  },
  {
   "drive": "tools/lib/b7_shootout.mjs",
   "timeout": 780000,
   "check": "D.ended && D.beats.includes('end')",
   "label": "VIII by the pad"
  },
  {
   "eval": "({ rumbleN: N.pad.rumbleN })"
  }
 ]
}