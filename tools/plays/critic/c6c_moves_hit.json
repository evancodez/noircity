   "shots": {
    "h_a": "!!(N.controller.run && N.controller.run.move && N.controller.run.move.kind === 'hit' && (N.controller.run.move.dur ? N.controller.run.move.t / N.controller.run.move.dur : N.controller.run.move.t) > 0.1)",
    "h_b": "!!(N.controller.run && N.controller.run.move && N.controller.run.move.kind === 'hit' && (N.controller.run.move.dur ? N.controller.run.move.t / N.controller.run.move.dur : N.controller.run.move.t) > 0.6)",
    "c_a": "!!(N.controller.run && N.controller.run.move && N.controller.run.move.kind === 'climb' && (N.controller.run.move.dur ? N.controller.run.move.t / N.controller.run.move.dur : N.controller.run.move.t) > 0.15)",
    "c_b": "!!(N.controller.run && N.controller.run.move && N.controller.run.move.kind === 'climb' && (N.controller.run.move.dur ? N.controller.run.move.t / N.controller.run.move.dur : N.controller.run.move.t) > 0.5)",
    "c_c": "!!(N.controller.run && N.controller.run.move && N.controller.run.move.kind === 'climb' && (N.controller.run.move.dur ? N.controller.run.move.t / N.controller.run.move.dur : N.controller.run.move.t) > 0.85)",
    "cr_a": "!!(N.controller.run && N.controller.run.move && N.controller.run.move.kind === 'crawl' && (N.controller.run.move.dur ? N.controller.run.move.t / N.controller.run.move.dur : N.controller.run.move.t) > 0.2)",
    "cr_b": "!!(N.controller.run && N.controller.run.move && N.controller.run.move.kind === 'crawl' && N.controller.run.move.t > 0.6)"
   }
  }
 ]
