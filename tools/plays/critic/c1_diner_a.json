{ "about": "Critic: BEGIN, click through the stills fast (mashed clicks), the diner's first beats by following what the screen says.",
  "url": "/?mute=1", "size": [1440, 900], "out": "shots/critic/diner_a",
  "steps": [
    { "wait": 2500 },
    { "clickOn": "#title .opt[data-k=begin]" },
    { "wait": 300 },
    { "mouse": "click", "x": 720, "y": 450 }, { "wait": 100 },
    { "mouse": "click", "x": 720, "y": 450 }, { "wait": 100 },
    { "mouse": "click", "x": 720, "y": 450 }, { "wait": 100 },
    { "eval": "JSON.stringify({active: G.stills.active, idx: G.stills.index, page: G.stills.page})" },
    { "shot": "a01_mash" },
    { "wait": 500 },
    { "mouse": "click", "x": 720, "y": 450 }, { "wait": 200 },
    { "shot": "a02_click1" },
    { "eval": "JSON.stringify({active: G.stills.active, keys: Object.keys(G.stills).join(',')})" },
    { "wait": 500 },
    { "mouse": "click", "x": 720, "y": 450 }, { "wait": 200 },
    { "shot": "a03_click2" },
    { "wait": 500 },
    { "mouse": "click", "x": 720, "y": 450 }, { "wait": 200 },
    { "shot": "a04_click3" },
    { "eval": "JSON.stringify({active: G.stills.active, scene: G.scenes.current && G.scenes.current.id})" },
    { "until": "G.scenes.current && G.scenes.current.id === 'diner' && G.state === 'playing'", "timeout": 15000 },
    { "wait": 2500 },
    { "eval": "Object.keys(G.hud).join(',')" },
    { "shot": "a05_diner" },
    { "key": "KeyE" },
    { "wait": 1500 }, { "shot": "a06" },
    { "eval": "JSON.stringify({beat: G.scenes.beat, obj: G.hud.objectiveText, prompt: document.querySelector('#prompt') && document.querySelector('#prompt').innerText})" },
    { "wait": 3000 }, { "shot": "a07" },
    { "eval": "JSON.stringify({beat: G.scenes.beat, obj: G.hud.objectiveText, prompt: document.querySelector('#prompt') && document.querySelector('#prompt').innerText})" },
    { "wait": 4000 }, { "shot": "a08" },
    { "eval": "JSON.stringify({beat: G.scenes.beat, obj: G.hud.objectiveText})" }
  ] }
