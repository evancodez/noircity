{
 "about": "[O7 critic] a first-timer: BEGIN, E at the coupe (latency), drive (W latency, steer), the radio, out, the wheel, a shot at nothing, then hands off for 70 s: what does the city do, can I lose",
 "url": "/?mute=1",
 "size": [1280, 800],
 "out": "shots/critic_o7/ds",
 "steps": [
  { "wait": 2500 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'city' && G.scenes.fadeK < 0.05", "timeout": 25000 },
  { "look": [0, 0], "steps": 1 }, { "eval": "(N.controller.pitch = 0, 1)" },
  { "wait": 800 },
  { "eval": "(()=>{window.__L={};addEventListener('keydown',e=>{if(!e.isTrusted)return;window.__L[e.code]={t:performance.now(),sp:G.city.car&&G.city.car.speed,in:G.city.inCar}},true);return 1})()" },
  { "eval": "'car d '+Math.hypot(G.city.car.pos.x-N.controller.pos.x,G.city.car.pos.z-N.controller.pos.z).toFixed(1)+' prompt '+G.hud.promptShown+' teach '+(G.hud.kit.teachCur&&G.hud.kit.teachCur.id)" },
  { "eval": "(()=>{window.__in=null;const t=()=>{if(G.city.inCar&&!window.__in){window.__in=performance.now();return}requestAnimationFrame(t)};requestAnimationFrame(t);return 1})()" },
  { "key": "KeyE", "hold": 60 },
  { "wait": 1500 },
  { "eval": "'E->inCar ms '+(window.__in&&window.__L.KeyE?(window.__in-window.__L.KeyE.t).toFixed(0):'none')+' inCar '+G.city.inCar+' teach '+(G.hud.kit.teachCur&&G.hud.kit.teachCur.id)+' HUD '+document.getElementById('hud').innerText.replace(/\\s+/g,' ').slice(0,200)" },
  { "shot": "incar" },
  { "eval": "(()=>{window.__mv=null;const c=G.city.car;const p0={x:c.pos.x,z:c.pos.z};const t=()=>{if(Math.hypot(c.pos.x-p0.x,c.pos.z-p0.z)>0.02&&!window.__mv){window.__mv=performance.now();return}requestAnimationFrame(t)};requestAnimationFrame(t);return 1})()" },
  { "down": "KeyW" }, { "wait": 2500 },
  { "eval": "'W->moves ms '+(window.__mv&&window.__L.KeyW?(window.__mv-window.__L.KeyW.t).toFixed(0):'none')+' speed '+(G.city.car.speed||0).toFixed(1)" },
  { "shot": "drive1" },
  { "down": "KeyA" }, { "wait": 700 }, { "up": "KeyA" },
  { "wait": 1500 }, { "shot": "drive2" },
  { "eval": "'HUD drive '+document.getElementById('hud').innerText.replace(/\\s+/g,' ').slice(0,200)+' teach '+(G.hud.kit.teachCur&&G.hud.kit.teachCur.id)" },
  { "key": "KeyF", "hold": 60 }, { "wait": 500 },
  { "eval": "'after F '+document.getElementById('hud').innerText.replace(/\\s+/g,' ').slice(0,200)" },
  { "up": "KeyW" }, { "down": "KeyS" }, { "wait": 2500 }, { "up": "KeyS" },
  { "eval": "'speed after brake '+(G.city.car.speed||0).toFixed(1)" },
  { "key": "KeyE", "hold": 60 }, { "wait": 1500 },
  { "eval": "'out: inCar '+G.city.inCar+' mode '+N.controller.mode" },
  { "drive": "tools/lib/o4_wheel.mjs", "dy": 100 }, { "wait": 600 },
  { "eval": "'wheel: '+G.player.weapons.current+' teach '+(G.hud.kit.teachCur&&G.hud.kit.teachCur.id)" },
  { "eval": "(N.controller.pitch = 0.5, 1)" },
  { "mouse": "click" }, { "wait": 400 },
  { "eval": "'after shot heat '+G.police.heat+' line '+G.hud.kit.objectiveText+' units '+(G.police.units||[]).length+' stand '+!!G.police.stand" },
  { "shot": "shot" },
  { "eval": "(N.controller.pitch = 0, 1)" },
  { "wait": 10000 }, { "eval": "'t10 heat '+G.police.heat+' s '+G.police.searching+' line '+G.hud.kit.objectiveText+' state '+G.state" },
  { "wait": 10000 }, { "eval": "'t20 heat '+G.police.heat+' s '+G.police.searching+' line '+G.hud.kit.objectiveText+' state '+G.state" },
  { "shot": "t20" },
  { "wait": 15000 }, { "eval": "'t35 heat '+G.police.heat+' s '+G.police.searching+' line '+G.hud.kit.objectiveText+' state '+G.state" },
  { "wait": 15000 }, { "eval": "'t50 heat '+G.police.heat+' s '+G.police.searching+' line '+G.hud.kit.objectiveText+' state '+G.state" },
  { "wait": 20000 }, { "eval": "'t70 heat '+G.police.heat+' s '+G.police.searching+' line '+G.hud.kit.objectiveText+' state '+G.state+' HUD '+document.getElementById('hud').innerText.replace(/\\s+/g,' ').slice(0,200)" },
  { "shot": "t70" }
 ]
}
