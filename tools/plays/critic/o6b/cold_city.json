  { "wait": 2500 },
  { "shot": "00_title" },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.fadeK < 0.05", "timeout": 30000 },
  { "wait": 1200 },
  { "eval": "JSON.stringify({scene:G.scenes.current.id, p:G.camera.position.toArray().map(v=>+v.toFixed(1)), car:G.city.car&&G.city.car.pos.toArray().map(v=>+v.toFixed(1)), n:G.city.cars.length, t:[...document.querySelectorAll('body *')].filter(e=>e.offsetParent&&e.children.length===0&&e.innerText&&e.innerText.trim()).map(e=>e.innerText.trim().slice(0,50)).join(' | ')})" },
  { "shot": "01_begin" },
  { "key": "KeyE", "hold": 80 },
  { "wait": 1200 },
  { "eval": "JSON.stringify({inCar:G.city.inCar, t:[...document.querySelectorAll('body *')].filter(e=>e.offsetParent&&e.children.length===0&&e.innerText&&e.innerText.trim()).map(e=>e.innerText.trim().slice(0,50)).join(' | ')})" },
  { "down": "KeyW" },
  { "wait": 3000 },
  { "eval": "JSON.stringify({v:+(G.city.car.speed*3.6).toFixed(0), pos:[+G.city.car.pos.x.toFixed(0),+G.city.car.pos.z.toFixed(0)], dmg:+G.city.car.damage.toFixed(2), st:G.city.car.smashD&&G.city.car.smashD.state})" },
  { "wait": 3000 },
  { "shot": "02_w6" },
  { "eval": "JSON.stringify({v:+(G.city.car.speed*3.6).toFixed(0), pos:[+G.city.car.pos.x.toFixed(0),+G.city.car.pos.z.toFixed(0)], dmg:+G.city.car.damage.toFixed(2), cr:G.city.car.stats&&G.city.car.stats.crashes})" },
  { "down": "KeyA" }, { "wait": 500 }, { "up": "KeyA" },
  { "wait": 3000 },
  { "eval": "JSON.stringify({v:+(G.city.car.speed*3.6).toFixed(0), pos:[+G.city.car.pos.x.toFixed(0),+G.city.car.pos.z.toFixed(0)], dmg:+G.city.car.damage.toFixed(2), cr:G.city.car.stats&&G.city.car.stats.crashes})" },
  { "shot": "03_after_left" },
  { "down": "KeyD" }, { "wait": 900 }, { "up": "KeyD" },
  { "wait": 3500 },
  { "shot": "04_more" },
  { "eval": "(() => { const c=G.city.car, D=c.smashD; return JSON.stringify({v:+(c.speed*3.6).toFixed(0), dmg:+c.damage.toFixed(2), st:D&&D.state, hood:D&&D.hood&&Object.keys(D.hood).join(','), doors:D&&D.doors.map(d=>d?Object.keys(d).slice(0,3).join(','):null), bump:D&&D.bumper.map(d=>d?Object.keys(d).slice(0,2).join(','):null), hub:D&&D.hub, wob:D&&D.wob.map(w=>!!w), t:[...document.querySelectorAll('body *')].filter(e=>e.offsetParent&&e.children.length===0&&e.innerText&&e.innerText.trim()).map(e=>e.innerText.trim().slice(0,50)).join(' | ')}); })()" },
  { "up": "KeyW" },
  { "down": "Space" }, { "wait": 1500 }, { "up": "Space" },
  { "key": "KeyE", "hold": 80 },
  { "wait": 1500 },
  { "look": [-700, 60], "steps": 12 },
  { "wait": 600 },
  { "shot": "05_out_look" },
  { "eval": "(() => { const all=G.city.cars.map(c=>c.smashD).filter(Boolean); return JSON.stringify({inCar:G.city.inCar, damaged: G.city.cars.filter(c=>c.damage>0.05).map(c=>[c.kind||c.model&&c.model.kind, +c.damage.toFixed(2), c.smashD&&c.smashD.state])}); })()" }
 ]
