  { "down": "KeyW" },
  { "until": "G.city.sinkT > 0 || G.failing", "timeout": 25000 },
  { "eval": "JSON.stringify({t:+(performance.now()/1000).toFixed(2), log: window.__rv})" },
  { "wait": 250 }, { "shot": "r1_splash_025" },
  { "wait": 400 }, { "shot": "r2_splash_065" },
  { "up": "KeyW" },
  { "until": "G.failing", "timeout": 8000 },
  { "wait": 200 }, { "shot": "r3_fail" },
  { "eval": "JSON.stringify({t:+(performance.now()/1000).toFixed(2), log: window.__rv, t2:[...document.querySelectorAll('body *')].filter(e=>e.offsetParent&&e.children.length===0&&e.innerText&&e.innerText.trim()).map(e=>e.innerText.trim().slice(0,50)).join(' | ')})" },
  { "until": "!G.failing && G.state === 'playing' && G.scenes.fadeK < 0.05", "timeout": 20000 },
  { "eval": "JSON.stringify({t:+(performance.now()/1000).toFixed(2), inCar:G.city.inCar, me:[G.controller.pos.x,G.controller.pos.z].map(v=>+v.toFixed(1)), beat: G.scenes.beat, t2:[...document.querySelectorAll('body *')].filter(e=>e.offsetParent&&e.children.length===0&&e.innerText&&e.innerText.trim()).map(e=>e.innerText.trim().slice(0,50)).join(' | ')})" },
  { "wait": 600 }, { "shot": "r4_ashore" }
 ]
