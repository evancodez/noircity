  },
  {
   "wait": 600
  },
  {
   "until": "Math.hypot(G.brawl.c.pos.x-G.eye.x,G.brawl.c.pos.z-G.eye.z) < 1.5 || (document.dispatchEvent(new KeyboardEvent('keydown',{code:'KeyW'})), false)",
