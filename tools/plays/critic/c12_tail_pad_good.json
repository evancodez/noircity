{
 "about": "[C12 critic] VI by the pad: the tail bot good, another seed",
 "url": "/?mute=1&padfake=1&start=tail",
 "input": "pad",
 "size": [
  1280,
  800
 ],
 "out": "shots/critic12/c12_tail_pad_good",
 "steps": [
  {
   "until": "G.state === 'title' && N.hud.titleShown",
   "timeout": 60000
  },
  {
   "wait": 1500
  },
  {
   "pad": {
    "b": [
     "x"
    ],
    "secs": 0.12
   }
  },
  {
   "until": "G.scenes.current && G.scenes.current.id === 'tail' && G.controller.mode === 'drive' && !G.scenes.fadeK",
   "timeout": 60000
  },
  {
   "drive": "tools/lib/c3_tail.mjs",
   "profile": "good",
   "seed": 3,
   "timeout": 600000,
   "stop": "G.scenes.current && G.scenes.current.id !== 'tail'",
   "check": "D.end === 'next:warehouse' || D.end === 'until'",
   "label": "good wins VI by the pad"
  },
  {
   "eval": "JSON.stringify({ fails: (window.__tailFails || []).map((f) => f.why + '@' + f.t + ' ' + f.phase), rumbles: N.pad.rumbleN })"
  }
 ]
}