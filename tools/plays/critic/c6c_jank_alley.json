{
 "about": "Critic C6 jank walk (alley): the chase's rules switched off to look round; run into each point, say what stops me. NOIR_PORT=5346 node tools/play.mjs tools/plays/critic/c6c_jank_alley.json",
 "url": "/?mute=1&start=watcher.alley",
 "size": [
  1440,
  900
 ],
 "out": "shots/c6c/jank",
 "steps": [
  {
   "until": "G.state === 'title' && !!document.querySelector('#title .opt[data-k=begin]')",
   "timeout": 40000
  },
  {
   "wait": 1200
  },
  {
   "clickOn": "#title .opt[data-k=begin]",
   "taken": "G.state !== 'title' && document.pointerLockElement === N.renderer.domElement",
   "retries": 5,
   "every": 4000
  },
  {
   "until": "G.scenes.current && G.scenes.current.id === 'watcher' && !(G.hud.cardT > 0.1) && N.controller.mode === 'run'",
   "timeout": 30000
  },
  {
   "eval": "(G.scenes.ctx.flags.chase.active = false, G.hud.warn(null), 'rules off: looking round')"
  },
  {
   "drive": "tools/plays/critic/c6c_poke.mjs",
   "points": [
    [
     2.5,
     -1.0,
     "alley mouth back to the street",
     8
    ],
    [
     2.5,
     12,
     "across Harbor St",
     6
    ],
    [
     30,
     0,
     "east along Harbor St",
     7
    ],
    [
     -25,
     0,
     "west along Harbor St",
     9
    ]
   ]
  }
 ]
}