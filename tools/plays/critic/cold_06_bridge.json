{
 "about": "[cold play] The bridge: from the river road's corner flat out up Bridge St onto the bridge and into its barrier (BRIDGE UP) - what stops the car, what the car shows; then out and on foot to the barrier, the raised leaves, and a look down to the water and back at the city.",
 "url": "/?mute=1&start=city&car=420,-416.5,0",
 "size": [1440, 900],
 "out": "shots/cold/06",
 "steps": [
  { "wait": 2500 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'city' && G.scenes.fadeK < 0.05 && G.city.inCar", "timeout": 25000 },
  { "wait": 800 },
  { "shot": "00_bridge_ahead" },
  { "down": "KeyW" },
  { "wait": 3500 },
  { "eval": "JSON.stringify({kmh: +(G.city.car.speed*3.6).toFixed(0), x: +G.city.car.pos.x.toFixed(1)})" },
  { "shot": "01_on_bridge" },
  { "until": "G.city.car.pos.x > 492 || G.city.car.stats.crashes > 0", "timeout": 8000 },
  { "eval": "JSON.stringify({kmh: +(G.city.car.speed*3.6).toFixed(0), x: +G.city.car.pos.x.toFixed(1)})" },
  { "wait": 1500 },
  { "up": "KeyW" },
  { "shot": "02_barrier_hit" },
  { "eval": "JSON.stringify({kmh: +(G.city.car.speed*3.6).toFixed(0), x: +G.city.car.pos.x.toFixed(1), stats: G.city.car.stats, dmg: G.city.car.damage, txt: document.body.innerText.replace(/\\s+/g,' ').slice(0,80)})" },
  { "key": "KeyE", "hold": 80 },
  { "wait": 2500 },
  { "look": [1, 0], "steps": 1 },
  { "eval": "(N.controller.pitch = -0.02, 1)" },
  { "look": "(() => { const C = N.controller; let a = Math.atan2(-1, 0) - C.yaw; a = Math.atan2(Math.sin(a), Math.cos(a)); return [Math.round(-a / 0.0021), 0]; })()", "steps": 6 },
  { "wait": 400 },
  { "shot": "03_out_at_barrier" },
  { "down": "KeyW" },
  { "wait": 4000 },
  { "up": "KeyW" },
  { "eval": "JSON.stringify({pos: [+N.controller.pos.x.toFixed(1), +N.controller.pos.z.toFixed(1)]})" },
  { "shot": "04_against_barrier" },
  { "key": "Space", "hold": 120 },
  { "down": "KeyW" },
  { "wait": 1500 },
  { "up": "KeyW" },
  { "eval": "JSON.stringify({pos: [+N.controller.pos.x.toFixed(1), +N.controller.pos.z.toFixed(1)], y: N.controller.groundY})" },
  { "look": [0, 160], "steps": 4 },
  { "look": [-750, 0], "steps": 8 },
  { "wait": 300 },
  { "shot": "05_down_to_water" },
  { "look": [0, -200], "steps": 4 },
  { "look": [-750, 0], "steps": 8 },
  { "wait": 300 },
  { "shot": "06_back_at_city" }
 ]
}
