{
 "about": "[C12 critic] menus by the pad, blind: right on the title, X (chapters?), down x3, X; options (pause), down to the rumble, toggle it, resume; R2 fires (no rumble with it off); reload; CONTINUE by X; then circle on the chapters list goes back",
 "url": "/?mute=1&padfake=1",
 "input": "pad",
 "size": [1440, 900],
 "out": "shots/critic12/menus",
 "steps": [
  { "until": "G.state === 'title' && N.hud.titleShown", "timeout": 40000 },
  { "wait": 1200 },
  { "pad": { "b": ["right"], "secs": 0.1 } }, { "wait": 400 },
  { "shot": "m0_title_right" },
  { "pad": { "b": ["x"], "secs": 0.1 } }, { "wait": 700 },
  { "shot": "m1_after_x" },
  { "eval": "({ st: G.state, ctx: N.pad.context(), chapters: !!document.querySelector('#title .chapters, #chapters') && getComputedStyle(document.querySelector('#title .chapters, #chapters')).display })" },
  { "pad": { "b": ["down"], "secs": 0.1 } }, { "wait": 250 },
  { "pad": { "b": ["down"], "secs": 0.1 } }, { "wait": 250 },
  { "pad": { "b": ["down"], "secs": 0.1 } }, { "wait": 400 },
  { "shot": "m2_list_down3" },
  { "pad": { "b": ["o"], "secs": 0.1 } }, { "wait": 600 },
  { "shot": "m3_after_circle" },
  { "eval": "({ st: G.state, ctx: N.pad.context() })" },
  { "pad": { "b": ["x"], "secs": 0.1 } }, { "wait": 700 },
  { "pad": { "b": ["down"], "secs": 0.1 } }, { "wait": 250 },
  { "pad": { "b": ["down"], "secs": 0.1 } }, { "wait": 250 },
  { "pad": { "b": ["down"], "secs": 0.1 } }, { "wait": 250 },
  { "pad": { "b": ["x"], "secs": 0.1 } },
  { "wait": 1500 },
  { "eval": "({ st: G.state, scene: G.scenes.current && G.scenes.current.id, stills: G.stills.active, ctx: N.pad.context() })" },
  { "until": "G.state === 'playing' && !G.stills.active && G.scenes.current && G.scenes.fadeK < 0.2", "timeout": 30000, "stop": false },
  { "wait": 2500 },
  { "eval": "({ scene: G.scenes.current && G.scenes.current.id, beat: G.scenes.beat, obj: G.hud.objectiveText })" },
  { "shot": "m4_chapter" },
  { "pad": { "b": ["opt"], "secs": 0.1 } }, { "wait": 500 },
  { "shot": "m5_pause" },
  { "pad": { "b": ["down"], "secs": 0.1 } }, { "wait": 200 },
  { "pad": { "b": ["down"], "secs": 0.1 } }, { "wait": 200 },
  { "pad": { "b": ["down"], "secs": 0.1 } }, { "wait": 200 },
  { "pad": { "b": ["down"], "secs": 0.1 } }, { "wait": 200 },
  { "pad": { "b": ["down"], "secs": 0.1 } }, { "wait": 200 },
  { "pad": { "b": ["down"], "secs": 0.1 } }, { "wait": 300 },
  { "shot": "m6_pause_down6" },
  { "pad": { "b": ["x"], "secs": 0.1 } }, { "wait": 300 },
  { "eval": "({ rumbleOn: N.pad.rumbleOn, paused: N.hud.paused, settings: N.hud.settings() })" },
  { "pad": { "b": ["right"], "secs": 0.1 } }, { "wait": 300 },
  { "eval": "({ rumbleOn: N.pad.rumbleOn, paused: N.hud.paused, settings: N.hud.settings() })" },
  { "shot": "m7_pause_after" },
  { "pad": { "b": ["opt"], "secs": 0.1 } }, { "wait": 600 },
  { "eval": "({ paused: N.hud.paused, holds: N.pad.holds, ctx: N.pad.context() })" },
  { "reload": true },
  { "until": "G.state === 'title' && N.hud.titleShown", "timeout": 40000 },
  { "wait": 1200 },
  { "pad": { "a": [0, 0.8, 0, 0], "secs": 0.15 } }, { "wait": 300 },
  { "pad": { "a": [0, -0.8, 0, 0], "secs": 0.15 } }, { "wait": 400 },
  { "shot": "m8_title_continue" },
  { "pad": { "b": ["x"], "secs": 0.1 } },
  { "until": "G.state === 'playing' && G.scenes.current && G.scenes.fadeK < 0.2 && !G.stills.active", "timeout": 30000, "stop": false },
  { "wait": 1500 },
  { "eval": "({ scene: G.scenes.current && G.scenes.current.id, beat: G.scenes.beat, holds: N.pad.holds, rumbleOn: N.pad.rumbleOn })" },
  { "shot": "m9_continued" }
 ]
}
