{
 "about": "[cold play] The el's stair at GRAND - CENTRE (west pavement of Grand Ave): walk to its foot and try to climb it to the platform (W into it, SPACE), then stand under the el and look up.",
 "url": "/?mute=1&start=city",
 "size": [1440, 900],
 "out": "shots/cold/07",
 "steps": [
  { "wait": 2500 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'city' && G.scenes.fadeK < 0.05", "timeout": 25000 },
  { "look": [1, 0], "steps": 1 },
  { "eval": "(N.controller.pitch = -0.02, 1)" },
  { "walk": [[-122, 24], [-130.2, 12]], "timeout": 20000, "stop": false },
  { "look": "(() => { const C = N.controller; let a = 0 - C.yaw; a = Math.atan2(Math.sin(a), Math.cos(a)); return [Math.round(-a / 0.0021), Math.round((C.pitch + 0.15) / 0.0021)]; })()", "steps": 6 },
  { "wait": 400 },
  { "shot": "00_stair_foot" },
  { "eval": "JSON.stringify({pos: [+N.controller.pos.x.toFixed(1), +N.controller.pos.z.toFixed(1)], eyeY: +G.camera.position.y.toFixed(2), txt: document.body.innerText.replace(/\\s+/g,' ').slice(0,80)})" },
  { "key": "KeyE", "hold": 80 },
  { "down": "KeyW" },
  { "wait": 3000 },
  { "key": "Space", "hold": 100 },
  { "wait": 1500 },
  { "up": "KeyW" },
  { "eval": "JSON.stringify({pos: [+N.controller.pos.x.toFixed(1), +N.controller.pos.z.toFixed(1)], eyeY: +G.camera.position.y.toFixed(2), txt: document.body.innerText.replace(/\\s+/g,' ').slice(0,80)})" },
  { "shot": "01_tried_stair" },
  { "look": [-748, 0], "steps": 8 },
  { "wait": 300 },
  { "shot": "02_station_side" },
  { "walk": [[-120, 8]], "timeout": 10000, "stop": false },
  { "look": [0, -260], "steps": 5 },
  { "wait": 300 },
  { "shot": "03_under_el_up" }
 ]
}
