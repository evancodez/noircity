{ "about": "Critic: a teach card is shown once per save: the test bed's cards seen, the page reloaded, CONTINUE: do they come again? And input during a fail's black.",
  "url": "/?mute=1&start=kit", "size": [1440, 900], "out": "shots/critic/teach_persist",
  "steps": [
    { "wait": 2500 },
    { "clickOn": "#title .opt[data-k=begin]" },
    { "until": "G.scenes.current && G.scenes.current.id === 'kit' && G.state === 'playing'", "timeout": 30000 },
    { "wait": 4500 },
    { "eval": "JSON.stringify({taught: G.save.flags.taught, saved: localStorage.getItem('noir.save'), cur: G.hud.kit.teachCur && G.hud.kit.teachCur.id})" },
    { "until": "!!G.failing", "timeout": 20000 },
    { "down": "KeyW" },
    { "mouse": "click", "x": 720, "y": 450 }, { "wait": 300 },
    { "mouse": "click", "x": 720, "y": 450 }, { "wait": 300 },
    { "mouse": "click", "x": 720, "y": 450 },
    { "eval": "JSON.stringify({ammo: G.player.weapons.active && G.player.weapons.active.ammo, eye: [G.eye.x.toFixed(2), G.eye.z.toFixed(2)]})" },
    { "until": "!G.failing", "timeout": 15000 },
    { "up": "KeyW" },
    { "wait": 200 },
    { "eval": "JSON.stringify({ammo: G.player.weapons.active && G.player.weapons.active.ammo, eye: [G.eye.x.toFixed(2), G.eye.z.toFixed(2)], beat: G.scenes.beat})" },
    { "shot": "t1_after_retry" },
    { "eval": "JSON.stringify({taught: G.save.flags.taught, saved: localStorage.getItem('noir.save')})" },
    { "reload": true }, { "wait": 2500 },
    { "eval": "JSON.stringify({cont: !document.querySelector('#title .opt[data-k=continue]').classList.contains('hidden')})" },
    { "clickOn": "#title .opt[data-k=continue]" },
    { "until": "G.scenes.current && G.scenes.current.id === 'kit' && G.state === 'playing'", "timeout": 30000 },
    { "wait": 1500 }, { "shot": "t2_continue" },
    { "eval": "JSON.stringify({cur: G.hud.kit.teachCur && G.hud.kit.teachCur.id, shown: G.hud.kit.shown, taught: G.save.flags.taught, stills: G.stills.last})" },
    { "wait": 3000 }, { "shot": "t3_continue" },
    { "eval": "JSON.stringify({cur: G.hud.kit.teachCur && G.hud.kit.teachCur.id, shown: G.hud.kit.shown})" }
  ] }
