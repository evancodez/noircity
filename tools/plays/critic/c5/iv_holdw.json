{
 "about": "Critic C5: IV with W held from the first second (the idle variant).",
 "url": "/?mute=1&start=gunfight",
 "size": [
  1440,
  900
 ],
 "out": "shots/critic/c5/iv_holdw",
 "steps": [
  {
   "name": "the title, BEGIN at IV"
  },
  {
   "until": "G.state === 'title' && !!document.querySelector('#title .opt[data-k=begin]')",
   "timeout": 60000
  },
  {
   "wait": 1500
  },
  {
   "clickOn": "#title .opt[data-k=begin]",
   "taken": "G.scenes.current && G.scenes.current.id === 'gunfight'",
   "retries": 4
  },
  {
   "until": "G.scenes.current && G.scenes.current.id === 'gunfight' && document.pointerLockElement === N.renderer.domElement",
   "timeout": 30000
  },
  {
   "wait": 1500
  },
  {
   "down": "KeyW"
  },
  {
   "shot": "w1"
  },
  {
   "wait": 6000
  },
  {
   "shot": "w2"
  },
  {
   "until": "(N.game.guns.events||[]).some((e)=>e.what==='down')",
   "timeout": 90000
  },
  {
   "up": "KeyW"
  },
  {
   "eval": "JSON.stringify({t:N.game.time, ev:(N.game.guns.events||[]).filter((e)=>e.what==='down'), warn:N.game.hud.kit.warnText, pos:[N.controller.pos.x,N.controller.pos.z]})"
  },
  {
   "wait": 2500
  },
  {
   "shot": "w3"
  }
 ]
}