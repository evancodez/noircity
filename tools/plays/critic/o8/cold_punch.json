{
 "about": "[O8 critic] cold: the title, the first frame, a walk up the street, the nearest walker punched by real input (LMB) until he falls, then hands off: does the fall read, does the man lie solid, what does the city do?",
 "url": "/?mute=1",
 "size": [1280, 800],
 "out": "shots/critic_o8",
 "steps": [
  { "wait": 2500 },
  { "eval": "document.querySelector('#title') && document.querySelector('#title').innerText.slice(0,300)" },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.state === 'playing' && G.people && G.scenes.beat === 'roam'", "timeout": 25000 },
  { "wait": 1500 },
  { "shot": "c1_first" },
  { "eval": "({ n: G.people.list.length, kinds: G.people.list.map(p=>p.kind+':'+p.role+':'+Math.round(Math.hypot(p.pos.x-G.eye.x,p.pos.z-G.eye.z))).join(' '), eye: [G.eye.x, G.eye.z] })" },
  { "key": "KeyW", "hold": 4000 },
  { "shot": "c2_walk" },
  { "drive": "tools/plays/critic/o3/cold.mjs", "mode": "punch", "hits": 3, "after": "idle", "secs": 30, "shots": true }
 ]
