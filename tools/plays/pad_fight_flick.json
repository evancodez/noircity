{
 "about": "[C12 after the critic] II by the pad: the left stick in a fist fight hops only on a flick. A walk in 33 deg and 45 deg off straight, a slow push to the side, a half pull back: no hop. A flick left, a flick right out of a walk forward, a flick back: one hop each. node tools/play.mjs tools/plays/pad_fight_flick.json",
 "url": "/?mute=1&padfake=1&start=fight",
 "input": "pad",
 "size": [1280, 800],
 "out": "shots/play/pad_fight_flick",
 "steps": [
  { "until": "G.state === 'title' && N.hud.titleShown", "timeout": 60000 },
  { "wait": 1500 },
  { "pad": { "b": ["x"], "secs": 0.12 }, "label": "the first press wakes the pad: the bracket only" },
  { "wait": 400 },
  { "pad": { "b": ["x"], "secs": 0.12 } },
  { "until": "G.scenes.current && G.scenes.current.id === 'fight' && G.brawl.active", "timeout": 60000 },
  { "wait": 1500 },
  { "eval": "(window.__k = [], document.addEventListener('keydown', (e) => { if (['KeyA', 'KeyD', 'KeyS'].includes(e.code)) window.__k.push([+N.time.toFixed(2), e.code]); }), 1)" },
  { "pad": { "a": [0.55, -0.83, 0, 0], "secs": 2.5 } },
  { "wait": 300 },
  { "expect": "window.__k.length === 0", "label": "a walk in 33 deg off straight: no hop (the critic's hopped KeyD)" },
  { "pad": { "a": [0.7, -0.7, 0, 0], "secs": 1.5 } },
  { "wait": 300 },
  { "expect": "window.__k.length === 0", "label": "a walk in 45 deg off straight: no hop" },
  { "pad": { "a": [0.2, 0, 0, 0], "hold": true } }, { "wait": 100 },
  { "pad": { "a": [0.4, 0, 0, 0], "hold": true } }, { "wait": 100 },
  { "pad": { "a": [0.55, 0, 0, 0], "hold": true } }, { "wait": 100 },
  { "pad": { "a": [0.7, 0, 0, 0], "hold": true } }, { "wait": 100 },
  { "pad": { "a": [0.9, 0, 0, 0], "hold": true } }, { "wait": 400 },
  { "pad": { "a": [0, 0, 0, 0], "hold": true } }, { "wait": 300 },
  { "expect": "window.__k.length === 0", "label": "a slow push to the side (0.3 to 0.65 in about 0.3 s): no hop" },
  { "pad": { "a": [0, 0.55, 0, 0], "secs": 1.0 } },
  { "wait": 300 },
  { "expect": "window.__k.length === 0", "label": "a half pull back: no hop" },
  { "wait": 600 },
  { "pad": { "a": [-1, 0, 0, 0], "secs": 0.25 } },
  { "wait": 700 },
  { "expect": "window.__k.length === 1 && window.__k[0][1] === 'KeyA'", "label": "a flick left: one hop left" },
  { "pad": { "a": [0, -1, 0, 0], "secs": 0.5 } },
  { "pad": { "a": [1, 0, 0, 0], "secs": 0.25 } },
  { "wait": 700 },
  { "expect": "window.__k.length === 2 && window.__k[1][1] === 'KeyD'", "label": "a walk forward, then a flick right: one hop right" },
  { "pad": { "a": [0, 1, 0, 0], "secs": 0.25 } },
  { "wait": 700 },
  { "expect": "window.__k.length === 3 && window.__k[2][1] === 'KeyS'", "label": "a flick back: one hop back" },
  { "eval": "({ keys: window.__k, hops: G.brawl.did })" },
  { "shot": "f00_after" }
 ]
}
