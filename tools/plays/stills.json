{
 "about": "Lane C9's stills (docs/story/briefs/C9_STILLS.md) by real input: BEGIN, the opening's three pictures stepped through by clicks (each loaded from public/stills/, not the placeholder); then, from the diner, every other run played as its chapter plays it (game.stills.play) and stepped through by clicks, E and SPACE; one left alone (it moves on by itself and ends in about its panels' seconds); one skipped by ESC twice; one ESC and a late one (the hint goes back when the second ESC would no longer skip); a frame of every page. node tools/play.mjs tools/plays/stills.json",
 "url": "/?mute=1",
 "size": [1440, 900],
 "out": "shots/play/stills",
 "steps": [
  { "name": "BEGIN: the opening, three pictures on one page" },
  { "wait": 1500 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.stills.active", "timeout": 6000 },
  { "expect": "G.stills.run.id === 'opening'", "label": "BEGIN plays the opening stills" },
  { "wait": 900 },
  { "shot": "s00_opening_1" },
  { "mouse": "click" },
  { "wait": 900 },
  { "mouse": "click" },
  { "wait": 1200 },
  { "shot": "s01_opening_page" },
  { "expect": "G.stills.run.panel === 2 && document.querySelectorAll('#stills .panel').length === 3", "label": "the page of three" },
  { "expect": "['opening:0','opening:1','opening:2'].every((k) => G.stills.cache.get(k) && G.stills.cache.get(k)._loaded)", "label": "the three pictures are lane C9's files (loaded and drawn), not the placeholders" },
  { "expect": "(() => { const c = document.querySelector('#stills .panel canvas'); const g = c.getContext('2d'); const d = g.getImageData(0, 0, c.width, c.height).data; let s = 0; for (let i = 0; i < d.length; i += 4 * 97) s += d[i]; return s > 0; })()", "label": "the first panel's picture is drawn" },
  { "mouse": "click" },
  { "until": "!G.stills.active", "timeout": 3000 },
  { "expect": "G.stills.last.id === 'opening' && !G.stills.last.skipped && G.stills.last.panels === 3", "label": "a click after the last panel ends the run" },
  { "until": "G.scenes.current && G.scenes.current.id === 'diner'", "timeout": 5000 },
  { "wait": 1500 },
  { "name": "the end of II: Ames's card (a click)" },
  { "eval": "(window.__h = G.stills.play('ames'), 'ames')" },
  { "wait": 1100 },
  { "shot": "s02_ames" },
  { "expect": "['ames:0'].every((k) => G.stills.cache.get(k) && G.stills.cache.get(k)._loaded)", "label": "ames_1.jpg loaded" },
  { "mouse": "click" },
  { "until": "window.__h.done", "timeout": 3000 },
  { "expect": "G.stills.last.id === 'ames' && G.stills.last.panels === 1 && !G.stills.last.skipped", "label": "one panel, a click ends it" },
  { "wait": 1200 },
  { "name": "III: the check (E, then SPACE)" },
  { "eval": "(window.__h = G.stills.play('check'), 'check')" },
  { "wait": 1000 },
  { "key": "KeyE" },
  { "wait": 1300 },
  { "shot": "s03_check_page" },
  { "expect": "G.stills.run.panel === 1 && document.querySelectorAll('#stills .panel').length === 2", "label": "E: the second panel beside the first" },
  { "expect": "['check:0','check:1'].every((k) => G.stills.cache.get(k) && G.stills.cache.get(k)._loaded)", "label": "check_1.jpg and check_2.jpg loaded" },
  { "key": "Space" },
  { "until": "window.__h.done", "timeout": 3000 },
  { "expect": "G.stills.last.id === 'check' && G.stills.last.panels === 2", "label": "SPACE ends it" },
  { "wait": 1200 },
  { "name": "VII: the photograph (a click)" },
  { "eval": "(window.__h = G.stills.play('photo'), 'photo')" },
  { "wait": 1100 },
  { "shot": "s04_photo" },
  { "expect": "['photo:0'].every((k) => G.stills.cache.get(k) && G.stills.cache.get(k)._loaded)", "label": "photo_1.jpg loaded" },
  { "mouse": "click" },
  { "until": "window.__h.done", "timeout": 3000 },
  { "wait": 1200 },
  { "name": "VIII: THE DINER (skipped: ESC twice)" },
  { "eval": "(window.__h = G.stills.play('diner'), 'diner')" },
  { "wait": 1100 },
  { "shot": "s05_diner" },
  { "expect": "['diner:0'].every((k) => G.stills.cache.get(k) && G.stills.cache.get(k)._loaded)", "label": "diner_1.jpg loaded" },
  { "key": "Escape" },
  { "wait": 300 },
  { "key": "Escape" },
  { "until": "window.__h.done", "timeout": 2500 },
  { "expect": "G.stills.last.id === 'diner' && G.stills.last.skipped === true", "label": "ESC twice skips it" },
  { "wait": 1500 },
  { "name": "[C9 after the critic] one ESC, then a late one: the hint says what is true" },
  { "eval": "(window.__h = G.stills.play('check'), 'check again')" },
  { "wait": 1000 },
  { "key": "Escape" },
  { "wait": 300 },
  { "expect": "/esc again skips/i.test(document.querySelector('#stills .hint').textContent) && G.stills.active", "label": "one ESC: 'esc again skips' and the run held" },
  { "wait": 1300 },
  { "expect": "/esc esc: skip/i.test(document.querySelector('#stills .hint').textContent) && G.stills.active", "label": "1.6 s later, the window shut: the hint is back to 'esc esc: skip'" },
  { "key": "Escape" },
  { "wait": 300 },
  { "key": "Escape" },
  { "until": "window.__h.done", "timeout": 2500 },
  { "expect": "G.stills.last.id === 'check' && G.stills.last.skipped === true", "label": "as the hint says: ESC twice skips" },
  { "wait": 1500 },
  { "name": "the end: left alone, it moves on by itself" },
  { "eval": "(window.__h = G.stills.play('end'), 'end')" },
  { "wait": 1400 },
  { "shot": "s06_end" },
  { "expect": "['end:0'].every((k) => G.stills.cache.get(k) && G.stills.cache.get(k)._loaded)", "label": "end_1.jpg loaded" },
  { "until": "window.__h.done", "timeout": 8000 },
  { "expect": "G.stills.last.id === 'end' && !G.stills.last.skipped && G.stills.last.secs >= 4 && G.stills.last.secs < 6", "label": "untouched, it ends after its four seconds" },
  { "until": "G.scenes.current && G.scenes.current.id === 'diner' && !G.stills.active", "timeout": 3000 },
  { "expect": "['opening','ames','check','photo','diner','end'].every((id) => G.stills.has(id))", "label": "the six runs are there" }
 ]
}
