{
 "about": "[O7] The night's HUD by real keys in the debug bed (?nightbed=1: the stand-in police and money, src/night/standins.js): BEGIN into the city; the minimap bottom left; heat 2 brushed in (two shields, the line 'Lose them.'), the search a half-tone ('Stay out of sight.'), the heat gone (struck, 'Clear.', then no line); $50 comes (the sum counted to, gone after); Tab held: the shields' empty slots, the money, the car's state and the hour; let go: gone. node tools/play.mjs tools/plays/o7_hud.json",
 "url": "/?mute=1&nightbed=1&start=city",
 "size": [1440, 900],
 "out": "shots/o7/hud",
 "steps": [
  { "wait": 1500 },
  { "expect": "G.stage.name === 'noircity' && N.hud.titleShown", "label": "the title stands over the city" },
  { "shot": "h00_title" },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'city' && G.scenes.fadeK < 0.05", "timeout": 30000 },
  { "wait": 1200 },
  { "expect": "document.querySelector('#hud .nmini.up') && G.night.mini.drawn", "label": "the minimap bottom left" },
  { "expect": "!document.querySelector('#hud .nheat.up') && !G.hud.objectiveText", "label": "no heat: no shields, no line" },
  { "key": "Digit2", "hold": 80 },
  { "wait": 700 },
  { "expect": "G.police.heat === 2 && !!document.querySelector('#hud .nheat.up') && document.querySelectorAll('#hud .nheat .b.on').length === 2", "label": "heat 2: two shields brushed in" },
  { "until": "G.hud.objectiveText === 'Lose them.'", "timeout": 2000, "label": "the line: Lose them." },
  { "shot": "h01_heat2" },
  { "key": "Digit9", "hold": 80 },
  { "wait": 500 },
  { "expect": "document.querySelector('#hud .nheat.srch') && G.hud.objectiveText === 'Stay out of sight.'", "label": "the search: half-tone, 'Stay out of sight.'" },
  { "key": "Digit0", "hold": 80 },
  { "wait": 300 },
  { "expect": "document.querySelectorAll('#hud .nheat .b.struck').length === 2 && G.hud.objectiveText === 'Clear.'", "label": "heat 0: struck through, 'Clear.'" },
  { "shot": "h02_clear" },
  { "wait": 3200 },
  { "expect": "!document.querySelector('#hud .nheat.up') && !G.hud.objectiveText", "label": "then nothing: no shields, no line" },
  { "key": "Digit8", "hold": 80 },
  { "wait": 900 },
  { "expect": "G.save.money === 50 && document.querySelector('#hud .nmoney.up') && document.querySelector('#hud .nmoney .v').textContent.includes('50')", "label": "$50 comes, counted to" },
  { "shot": "h03_money" },
  { "until": "!document.querySelector('#hud .nmoney.up')", "timeout": 6000, "label": "and goes" },
  { "down": "Tab" },
  { "wait": 400 },
  { "expect": "document.querySelector('#hud .ntab.up') && document.querySelector('#hud .nheat.tab.up') && document.querySelector('#hud .nmoney.up') && /coupe/.test(document.querySelector('#hud .ntab').textContent) && /(am|pm)/.test(document.querySelector('#hud .ntab').textContent)", "label": "Tab held: the shields' slots, the money, the car, the hour" },
  { "shot": "h04_tab" },
  { "up": "Tab" },
  { "wait": 900 },
  { "expect": "!document.querySelector('#hud .ntab.up') && !document.querySelector('#hud .nheat.up')", "label": "Tab let go: gone" }
 ]
}
