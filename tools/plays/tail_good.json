{
 "about": "Chapter VI, the tail (lane C3), by real input: a player who uses what was taught (src/scenes/tail/bot.js 'good': reads the corners, brakes before them, the handbrake at the tight ones, keeps 12 to 30 m off him; on the river road RMB, the mouse onto his rear tyre, LMB) WINS: the chase kept, his car stopped by my rounds, the drive to Pier 9, E by the gate, chapter VII opens. node tools/play.mjs tools/plays/tail_good.json (NOIR_PORT=5343)",
 "url": "/?mute=1&start=tail",
 "size": [1280, 800],
 "out": "shots/c3/play_good",
 "steps": [
  { "name": "the title, BEGIN at the tail" },
  { "until": "G.state === 'title' && !document.getElementById('title').classList.contains('hidden') && !!document.querySelector('#title .opt[data-k=begin]')", "timeout": 40000 },
  { "wait": 2000 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state === 'playing' && document.pointerLockElement === N.renderer.domElement", "retries": 4, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'tail' && G.controller.mode === 'drive'", "timeout": 45000 },
  { "expect": "G.controller.mode === 'drive' && G.hands.set === 'drive' && !!G.vehicles.player && G.stage.name === 'city'", "label": "in my coupe at Pell Lane's kerb, the hands on the wheel, in the city" },
  { "wait": 1500 },
  { "shot": "g00_kerb" },
  { "name": "the tail, the river road, the gun, the wreck, the pier" },
  { "drive": "tools/lib/c3_tail.mjs", "profile": "good", "seed": 7, "timeout": 420000,
    "stop": "G.scenes.current && G.scenes.current.id !== 'tail'",
    "shots": {
      "g01_off": "!!G.scenes.ctx.flags.chase && G.scenes.ctx.flags.chase.phase === 'a' && G.scenes.ctx.flags.chase.my.speed > 9",
      "g02_square": "!!G.scenes.ctx.flags.chase && G.scenes.ctx.flags.chase.driver.legIndex === 1 && G.scenes.ctx.flags.chase.my.pos.z < -120 && G.scenes.ctx.flags.chase.my.pos.x > -160",
      "g03_avenue": "!!G.scenes.ctx.flags.chase && G.scenes.ctx.flags.chase.my.pos.x > -104 && G.scenes.ctx.flags.chase.my.pos.x < -94 && G.scenes.ctx.flags.chase.my.pos.z < -200",
      "g04_baxter": "!!G.scenes.ctx.flags.chase && G.scenes.ctx.flags.chase.driver.legIndex === 2 && G.scenes.ctx.flags.chase.my.pos.z > -200 && G.scenes.ctx.flags.chase.my.pos.z < -140",
      "g05_alley": "!!G.scenes.ctx.flags.chase && Math.abs(G.scenes.ctx.flags.chase.my.pos.x - 12.5) < 3 && G.scenes.ctx.flags.chase.my.pos.z > -80 && G.scenes.ctx.flags.chase.my.pos.z < -50",
      "g06_river": "!!G.scenes.ctx.flags.chase && G.scenes.ctx.flags.chase.phase === 'b' && G.scenes.ctx.flags.chase.my.pos.z > -200",
      "g07_gun": "!!G.scenes.ctx.flags.chase && G.scenes.ctx.flags.chase.gun.aimK > 0.99",
      "g08_hit": "!!G.scenes.ctx.flags.chase && G.scenes.ctx.flags.chase.gun.hits >= 1",
      "g09_crash": "!!G.scenes.ctx.flags.chase && G.scenes.ctx.flags.chase.phase === 'crash' && (G.scenes.ctx.flags.chase.crashT || 0) > 0.5",
      "g10_wreck": "!!G.scenes.ctx.flags.chase && G.scenes.ctx.flags.chase.phase === 'wreck'",
      "g11_pier": "!!G.scenes.ctx.flags.chase && G.scenes.ctx.flags.chase.phase === 'c' && G.scenes.ctx.flags.chase.my.pos.z > 140",
      "g12_gate": "G.hud.promptShown.includes('get out')"
    },
    "check": "D.end === 'next:warehouse' || D.end === 'until'", "label": "the good hands win: chapter VII opens at the pier" },
  { "eval": "JSON.stringify({ fails: window.__tailFails || [], log: (window.__tail && window.__tail.log || []).slice(-6) })" },
  { "expect": "G.scenes.current && G.scenes.current.id === 'warehouse'", "label": "chapter VII (Pier Nine) begins" },
  { "shot": "g13_next" }
 ]
}
