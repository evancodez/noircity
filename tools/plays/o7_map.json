{
 "about": "[O7] The map and the pause card by real keys: M opens the map on the pause card (the frame dims, the game held: the clock stands), M closes it (the controls back, W walks); M then ESC (the browser letting the lock go, stood in as kit_esc.json does): the pause card proper with the map at its side, the settings line with sound, the matchbooks row (one taken in the bed), click resumes. node tools/play.mjs tools/plays/o7_map.json",
 "url": "/?mute=1&nightbed=1&start=city",
 "size": [1440, 900],
 "out": "shots/o7/map",
 "steps": [
  { "wait": 1500 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'city' && G.scenes.fadeK < 0.05", "timeout": 30000 },
  { "wait": 1000 },
  { "key": "Digit7", "hold": 80 },
  { "key": "Digit3", "hold": 80 },
  { "wait": 400 },
  { "key": "KeyM", "hold": 80 },
  { "wait": 500 },
  { "eval": "(window.__t0 = G.time, 1)" },
  { "expect": "G.night.map.open && G.night.holding && document.querySelector('#pausecard.mview:not(.hidden)') && !N.hud.paused", "label": "M: the map on the card, the game held" },
  { "wait": 800 },
  { "expect": "G.time === window.__t0", "label": "held: no step while it is read" },
  { "shot": "m00_map" },
  { "key": "KeyM", "hold": 80 },
  { "wait": 400 },
  { "expect": "!G.night.map.open && !G.night.holding && document.querySelector('#pausecard').classList.contains('hidden') && !N.controller.frozen && G.time > window.__t0", "label": "M again: closed, the game runs, the controls mine" },
  { "eval": "(window.__p0 = [N.controller.pos.x, N.controller.pos.z], 1)" },
  { "key": "KeyW", "hold": 700 },
  { "expect": "Math.hypot(N.controller.pos.x - window.__p0[0], N.controller.pos.z - window.__p0[1]) > 0.5", "label": "W walks after the map" },
  { "key": "KeyM", "hold": 80 },
  { "wait": 400 },
  { "eval": "(document.exitPointerLock(), 1)" },
  { "wait": 700 },
  { "expect": "N.hud.paused && !G.night.map.open && !G.night.holding && document.querySelector('#pausecard.ncity:not(.mview):not(.hidden) .nmapp') && document.querySelector('#pausecard .set').textContent.includes('sound') && document.querySelectorAll('#pausecard .nmatch canvas').length >= 2", "label": "ESC: the pause card, the map at its side, sound in the settings, the matchbooks" },
  { "shot": "m01_pause" },
  { "clickOn": "#pausecard h1" },
  { "until": "!N.hud.paused && document.pointerLockElement", "timeout": 5000, "label": "click resumes" }
 ]
}
