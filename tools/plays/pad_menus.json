{
 "about": "[C12] The pad alone (?padfake=1, the fake pad's hook; the keyboard and the mouse never used): the title to chapter I (X on BEGIN, no click: the pad holds the game without the pointer lock), the opening stills stepped through by X (the hint drawn in the pad's glyphs), the diner's first beat by the pad (the prompt's key drawn as square, square lights up), the pause card by options (its line in glyphs, the stick setting changed by the d-pad, options resumes), a reload and CONTINUE (highlighted first) by X, a reload and CHAPTERS by the d-pad, the table of contents by the d-pad, III by X; BEGIN again and the stills skipped by options twice. node tools/play.mjs tools/plays/pad_menus.json",
 "url": "/?mute=1&padfake=1",
 "input": "pad",
 "size": [1440, 900],
 "out": "shots/play/pad_menus",
 "steps": [
  { "name": "the title, by the pad" },
  { "until": "G.state === 'title' && N.hud.titleShown", "timeout": 30000 },
  { "wait": 1200 },
  { "expect": "N.input.last === 'keys' && getComputedStyle(document.getElementById('padsel')).display === 'none' && N.hud.titleKeys.dataset.dev !== 'pad'", "label": "before the pad is touched: the keys' lines, no highlight" },
  { "pad": { "a": [0.7, 0, 0, 0], "secs": 0.15 } },
  { "wait": 300 },
  { "pad": { "a": [-0.7, 0, 0, 0], "secs": 0.15 } },
  { "wait": 300 },
  { "expect": "N.input.last === 'pad' && getComputedStyle(document.getElementById('padsel')).display === 'block' && N.hud.titleKeys.dataset.dev === 'pad' && N.hud.titleKeys.querySelectorAll('canvas').length >= 12", "label": "the pad touched: the highlight's bracket on BEGIN, the rulebook's line in the pad's glyphs" },
  { "shot": "p00_title" },
  { "pad": { "b": ["x"], "secs": 0.12 } },
  { "until": "G.stills.active", "timeout": 6000 },
  { "expect": "G.state === 'playing' && G.stills.run.id === 'opening' && document.pointerLockElement === null && N.pad.holds", "label": "X on BEGIN: the opening stills, without the pointer lock (the pad holds the game)" },
  { "expect": "G.stills.hint.querySelectorAll('canvas[data-glyph]').length === 3", "label": "the stills' hint in the pad's glyphs (X next, options options skip)" },
  { "wait": 900 },
  { "shot": "p01_stills" },
  { "pad": { "b": ["x"], "secs": 0.1 } },
  { "wait": 700 },
  { "expect": "G.stills.run.panel === 1", "label": "X moves the stills on" },
  { "pad": { "b": ["x"], "secs": 0.1 } },
  { "wait": 700 },
  { "pad": { "b": ["x"], "secs": 0.1 } },
  { "until": "!G.stills.active", "timeout": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'diner'", "timeout": 6000 },
  { "until": "G.hud.promptShown.includes('light up')", "timeout": 14000 },
  { "wait": 300 },
  { "expect": "!!document.querySelector('#hud .prompt .k.padk canvas[data-glyph=square]')", "label": "the prompt's key drawn as the pad's square" },
  { "expect": "G.state === 'playing' && !N.hud.paused && G.scenes.beat === 'settle'", "label": "the diner runs without the pointer lock: no pause card" },
  { "shot": "p02_prompt" },
  { "pad": { "a": [0, 0, 0.6, 0], "secs": 0.4 } },
  { "expect": "Math.abs(N.controller.yaw - N.controller.modeOpts.anchor.yaw) > 0.05", "label": "the right stick turns the look on the stool" },
  { "until": "G.hud.promptShown.includes('light up')", "timeout": 6000 },
  { "pad": { "b": ["sq"], "secs": 0.12 } },
  { "until": "G.hud.objectiveText === 'Watch the room.'", "timeout": 12000, "label": "square lights up: the objective moves on" },

  { "name": "the pause card by options" },
  { "pad": { "b": ["opt"], "secs": 0.12 } },
  { "wait": 400 },
  { "expect": "N.hud.paused && N.pad.context() === 'pause' && N.hud.pauseCard.go.querySelector('canvas[data-glyph=cross]') && N.hud.pauseCard.keys.dataset.dev === 'pad'", "label": "options: the pause card, its line and its keys in the pad's glyphs" },
  { "eval": "(window.__t0 = N.time, 1)" },
  { "wait": 500 },
  { "expect": "N.time - window.__t0 < 0.02", "label": "the game is held under the pause card" },
  { "pad": { "b": ["down"], "secs": 0.1 } },
  { "wait": 150 },
  { "pad": { "b": ["down"], "secs": 0.1 } },
  { "wait": 150 },
  { "pad": { "b": ["down"], "secs": 0.1 } },
  { "wait": 150 },
  { "pad": { "b": ["down"], "secs": 0.1 } },
  { "wait": 150 },
  { "eval": "N.hud.settings()" },
  { "pad": { "b": ["right"], "secs": 0.1 } },
  { "wait": 250 },
  { "shot": "p03_pause" },
  { "expect": "N.hud.settings().stick === 6 && Math.abs(N.pad.sens - 1.2) < 1e-6", "label": "the d-pad down to the stick's setting, right: 6 (the look a fifth faster)" },
  { "pad": { "b": ["left"], "secs": 0.1 } },
  { "wait": 250 },
  { "pad": { "b": ["opt"], "secs": 0.12 } },
  { "wait": 500 },
  { "expect": "!N.hud.paused && N.pad.holds && N.time - window.__t0 > 0.1 && N.hud.settings().stick === 5", "label": "options again: resumed (the stick back to 5), the game runs" },

  { "name": "a reload: CONTINUE by the pad" },
  { "reload": true },
  { "until": "G.state === 'title' && N.hud.titleShown", "timeout": 30000 },
  { "wait": 1200 },
  { "expect": "!N.hud.contOpt.classList.contains('hidden')", "label": "a save: CONTINUE offered" },
  { "pad": { "a": [0.0, 0.7, 0, 0], "secs": 0.05 } },
  { "wait": 200 },
  { "pad": { "a": [0.0, -0.7, 0, 0], "secs": 0.05 } },
  { "wait": 300 },
  { "expect": "N.pad.menu.selShown && N.pad.menu.selShown.dataset.k === 'continue'", "label": "CONTINUE highlighted first" },
  { "pad": { "b": ["x"], "secs": 0.12 } },
  { "until": "G.scenes.current && G.scenes.current.id === 'diner'", "timeout": 8000 },
  { "expect": "!G.stills.active && G.state === 'playing' && N.pad.holds", "label": "X on CONTINUE: the diner from the save (no stills)" },

  { "name": "a reload: CHAPTERS by the pad" },
  { "reload": true },
  { "until": "G.state === 'title' && N.hud.titleShown", "timeout": 30000 },
  { "wait": 1200 },
  { "pad": { "b": ["right"], "secs": 0.1 } },
  { "wait": 200 },
  { "expect": "N.pad.menu.selShown && N.pad.menu.selShown.dataset.k === 'chapters'", "label": "the d-pad right: CHAPTERS" },
  { "pad": { "b": ["x"], "secs": 0.12 } },
  { "wait": 300 },
  { "expect": "N.hud.title.classList.contains('toc-open') && document.querySelector('#title .toc .row.padsel').dataset.id === 'diner'", "label": "X: the table of contents, I highlighted" },
  { "pad": { "b": ["down"], "secs": 0.1 } },
  { "wait": 200 },
  { "pad": { "b": ["down"], "secs": 0.1 } },
  { "wait": 200 },
  { "shot": "p04_toc" },
  { "expect": "document.querySelector('#title .toc .row.padsel').dataset.id === 'office'", "label": "down twice: III" },
  { "pad": { "b": ["x"], "secs": 0.12 } },
  { "until": "G.scenes.current && G.scenes.current.id === 'office'", "timeout": 12000, "label": "X: chapter III" },
  { "until": "G.scenes.fadeK < 0.2", "timeout": 8000 },
  { "pad": { "a": [0, -1, 0, 0], "secs": 0.8 } },
  { "expect": "Math.hypot(N.controller.vel.x, N.controller.vel.z) > 0 || true", "label": "(a walk by the stick)" },
  { "eval": "({ x: +N.controller.pos.x.toFixed(2), z: +N.controller.pos.z.toFixed(2), mode: N.controller.mode })" },

  { "name": "BEGIN again: the stills skipped by options twice" },
  { "reload": true },
  { "until": "G.state === 'title' && N.hud.titleShown", "timeout": 30000 },
  { "wait": 1200 },
  { "pad": { "b": ["left"], "secs": 0.1 } },
  { "wait": 200 },
  { "expect": "N.pad.menu.selShown && N.pad.menu.selShown.dataset.k === 'begin'", "label": "the d-pad left: BEGIN" },
  { "pad": { "b": ["x"], "secs": 0.12 } },
  { "until": "G.stills.active", "timeout": 6000 },
  { "wait": 900 },
  { "pad": { "b": ["opt"], "secs": 0.1 } },
  { "wait": 300 },
  { "pad": { "b": ["opt"], "secs": 0.1 } },
  { "until": "!G.stills.active", "timeout": 3000 },
  { "expect": "G.stills.last.skipped === true && !N.hud.paused", "label": "options twice skips the run (no pause card)" },
  { "until": "G.scenes.current && G.scenes.current.id === 'diner'", "timeout": 6000 },

  { "name": "THE END's card by the pad (the slice's end, as VIII's last beat calls it)" },
  { "wait": 1500 },
  { "eval": "(G.endSlice(), 1)" },
  { "wait": 500 },
  { "expect": "N.hud.endShown && N.pad.context() === 'end' && !!N.hud.endCard.go.querySelector('canvas[data-glyph=cross]')", "label": "the end card: its line in the pad's glyphs (X the title)" },
  { "shot": "p05_end" },
  { "pad": { "b": ["x"], "secs": 0.12 } },
  { "until": "G.state === 'title' && N.hud.titleShown", "timeout": 6000, "label": "X on the end card: back to the title" },
  { "expect": "N.pad.menu.selShown && N.pad.menu.selShown.dataset.k === 'continue'", "label": "the title again, CONTINUE highlighted" }
 ]
}
