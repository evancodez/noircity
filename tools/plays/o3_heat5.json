{
 "about": "[O3] HEAT 5 on foot, idle: everything - the detectives' car, the patrol cars, the riot squad's lorry and its three; down, warned, the hospital.",
 "url": "/?mute=1&start=city",
 "size": [
  1280,
  800
 ],
 "out": "shots/o3/o3_heat5",
 "steps": [
  {
   "wait": 1500
  },
  {
   "clickOn": "#title .opt[data-k=begin]",
   "taken": "G.state !== 'title'",
   "retries": 5,
   "every": 4000
  },
  {
   "until": "G.scenes.current && G.scenes.current.id === 'city' && G.scenes.fadeK < 0.05 && !!G.people",
   "timeout": 30000
  },
  {
   "wait": 1500
  },
  {
   "drive": "tools/lib/o3_people.mjs",
   "mode": "chase",
   "heat": 5,
   "profile": "idle",
   "onFoot": true,
   "tries": 1,
   "check": "D.wins === 1",
   "label": "HEAT 5 idle on foot: warned, down, the hospital"
  },
  {
   "eval": "JSON.stringify(G.police.events.filter(e => e.what === 'car').map(e => e.role))"
  }
 ]
}