   "taken": "G.state !== 'title'",
   "retries": 5,
   "every": 4000
  },
  {
   "until": "G.scenes.current && G.scenes.current.id === 'watcher' && G.scenes.beat === 'seen' && !(G.hud.cardT > 0.1)",
