   "timeout": 20000
  },
  {
   "expect": "G.lastFail.why === 'Lost him.' && G.lastFail.to === 'escape' && G.lastFail.warnedFor >= 1",
   "label": "escape: idle loses him ('Lost him.'), warned at least a second before, back at the start of the stretch"
