   "timeout": 30000
  },
  {
   "eval": "({ warnAfter: +(N.time - window.__t0).toFixed(1), gap: G.scenes.ctx.flags.chase ? +G.scenes.ctx.flags.chase.gapNow.toFixed(1) : null })"
  },
  {
   "until": "!!G.failing",
   "timeout": 20000
