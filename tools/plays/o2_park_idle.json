{
 "about": "[O2] The hijack of a parked car, idle hands (brief O2 \u00a73, \u00a75). node tools/play.mjs tools/plays/o2_park_idle.json",
 "url": "/?mute=1&start=city&park=saloon",
 "size": [
  1280,
  800
 ],
 "out": "shots/o2/park_idle",
 "steps": [
  {
   "wait": 1500
  },
  {
   "clickOn": "#title .opt[data-k=begin]",
   "taken": "G.state !== 'title'",
   "retries": 5,
   "every": 4000
  },
  {
   "until": "G.scenes.current && G.scenes.current.id === 'city' && G.scenes.fadeK < 0.05",
   "timeout": 20000
  },
  {
   "wait": 800
  },
  {
   "drive": "tools/lib/o2_wheels.mjs",
   "mode": "park",
   "hands": "idle",
   "check": "D.hands === 'idle' && D.inCar === false && D.took === false",
   "label": "idle: nothing taken, nothing lost (the car stands at the kerb)"
  }
 ]
}