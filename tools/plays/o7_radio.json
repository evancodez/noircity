{
 "about": "[O7] The radio by real keys: into the car, F turns the dial (WJZZ 1170 shown bottom right), F F (KBLU, WBND), F (off); on again, then out of the car: it fades with the door; back in: the car kept its station. node tools/play.mjs tools/plays/o7_radio.json",
 "url": "/?mute=1&start=city",
 "size": [1280, 800],
 "out": "shots/o7/radio",
 "steps": [
  { "wait": 1500 },
  { "clickOn": "#title .opt[data-k=begin]", "taken": "G.state !== 'title'", "retries": 5, "every": 4000 },
  { "until": "G.scenes.current && G.scenes.current.id === 'city' && G.scenes.fadeK < 0.05", "timeout": 30000 },
  { "wait": 1000 },
  { "until": "!!G.hud.kit.teachCur || G.hud.promptShown === 'E  get in'", "timeout": 6000 },
  { "key": "KeyE", "hold": 80 },
  { "until": "G.city.inCar", "timeout": 4000 },
  { "wait": 700 },
  { "key": "KeyF", "hold": 80 },
  { "wait": 300 },
  { "expect": "G.night.radio.name === 'WJZZ' && !!document.querySelector('#hud .nradio.up') && document.querySelector('#hud .nradio').textContent.includes('1170')", "label": "F: WJZZ 1170 on the dial" },
  { "shot": "r00_dial" },
  { "key": "KeyF", "hold": 80 }, { "wait": 200 },
  { "key": "KeyF", "hold": 80 }, { "wait": 200 },
  { "expect": "G.night.radio.name === 'WBND'", "label": "F F: KBLU, WBND" },
  { "key": "KeyF", "hold": 80 }, { "wait": 200 },
  { "expect": "G.night.radio.station === -1 && G.night.radio.cur === null", "label": "F: off" },
  { "key": "KeyF", "hold": 80 }, { "wait": 300 },
  { "expect": "G.night.radio.name === 'WJZZ' && G.night.radio.cur !== null", "label": "on again" },
  { "key": "KeyE", "hold": 80 },
  { "until": "!G.city.inCar", "timeout": 4000 },
  { "wait": 300 },
  { "expect": "G.night.radio.cur === null", "label": "out of the car: gone with the door" },
  { "wait": 800 },
  { "eval": "(N.controller.yaw = Math.atan2(-(G.city.car.pos.x - N.controller.pos.x), -(G.city.car.pos.z - N.controller.pos.z)), 1)" },
  { "until": "G.hud.promptShown === 'E  get in' || !!G.hud.kit.teachCur", "timeout": 6000 },
  { "key": "KeyE", "hold": 80 },
  { "until": "G.city.inCar", "timeout": 4000 },
  { "wait": 300 },
  { "expect": "G.night.radio.name === 'WJZZ' && G.night.radio.cur !== null", "label": "back in: the car kept its station" }
 ]
}
