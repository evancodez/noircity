  },
  {
   "walk": [
    [
     0,
     24
    ],
    [
     45,
     20
    ]
   ],
   "timeout": 20000,
   "into": true
  },
  {
   "eval": "'east: ' + JSON.stringify(P())"
  },
  {
   "expect": "N.controller.pos.x < 25",
   "label": "the fence stops me east"
  },
  {
   "walk": [
    [
     5,
