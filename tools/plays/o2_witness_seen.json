{
 "about": "[O2] The parked-car witness, seen (brief O2 \u00a73, \u00a75): a car stands in the lane beside the start (its man at the wheel); I break into the saloon ahead in his sight: the crime event says seen. node tools/play.mjs tools/plays/o2_witness_seen.json",
 "url": "/?mute=1&start=city&park=saloon&come=coupe:civilian&held=1",
 "size": [
  1280,
  800
 ],
 "out": "shots/o2/o2_witness_seen",
 "steps": [
  {
   "wait": 1500
  },
  {
   "clickOn": "#title .opt[data-k=begin]",
   "taken": "G.state !== 'title'",
   "retries": 5,
   "every": 4000
  },
  {
   "until": "G.scenes.current && G.scenes.current.id === 'city' && G.scenes.fadeK < 0.05",
   "timeout": 20000
  },
  {
   "wait": 1000
  },
  {
   "drive": "tools/lib/o2_wheels.mjs",
   "mode": "witness",
   "hands": "good",
   "waitCar": true,
   "check": "D.log.some((e) => e.kind === 'hijack' && e.seen === true && e.by === 'driver')",
   "label": "seen: the event says so"
  }
 ]
}