{
 "about": "Scene 4, Room 304, by real input (tools/play.mjs): out of the corridor's dark end to the lit door, a push, the room, the pad rubbed until the numbers come up, the sheet torn off, the picture swung aside, the dial turned right-left-right by the numbers on the sheet, the handle, the ledger taken, held up, put away; on into scene 5. node tools/play.mjs tools/plays/office.json",
 "url": "/?mute=1&start=office",
 "size": [1280, 800],
 "out": "shots/play/office",
 "steps": [
  { "name": "the title, BEGIN at scene 4" },
  { "wait": 2500 },
  { "key": "KeyA" },
  { "clickOn": "#title .opt[data-k=begin]" },
  { "mouse": "up", "x": 640, "y": 400, "name": "(the cursor back to the frame's middle before the lock takes it: its jump from the button is never a look)" },
  { "until": "G.scenes.current && G.scenes.current.id === 'office' && document.pointerLockElement === N.renderer.domElement", "timeout": 10000 },
  { "expect": "G.stage.name === 'office' && G.scenes.beat === 'corridor' && G.controller.mode === 'walk'", "label": "in the corridor, walking" },
  { "wait": 2600 },
  { "shot": "o01_corridor" },
  { "expect": "G._room === 'corridor'", "label": "the corridor's own sound" },

  { "name": "1. the corridor: to the lit door, and a touch" },
  { "walk": [[-1.0, -2.0], [-0.95, 0.4], [-0.85, 1.02], [-0.45, 1.02]], "timeout": 25000 },
  { "until": "G.scenes.beat === 'room' || G.hands.current === 'b2_push'", "timeout": 4000 },
  { "wait": 400 },
  { "shot": "o02_push" },
  { "until": "G.scenes.beat === 'room'", "timeout": 5000 },
  { "expect": "G.stage.part('office').door.angle > 0.9", "label": "the door swung in at a touch" },

  { "name": "2. the room; the drawers answer E" },
  { "walk": [[0.7, 1.1], [1.4, 4.2], [1.2, 5.4]], "timeout": 20000 },
  { "look": [0, 220], "steps": 6 },
  { "wait": 500 },
  { "eval": "G.hud.promptShown" },
  { "until": "G.hud.promptShown.includes('drawers')", "timeout": 5000, "stop": false },
  { "key": "KeyE" },
  { "wait": 600 },
  { "expect": "G.hud.sayShown === 'Somebody was here first.'", "label": "the drawers: Somebody was here first." },
  { "shot": "o03_drawers" },

  { "name": "3. the pad: the pencil's side across the next sheet" },
  { "walk": [[2.2, 5.0], [4.88, 5.1], [4.88, 3.95]], "timeout": 25000 },
  { "look": [-748, 118], "steps": 12 },
  { "wait": 400 },
  { "until": "G.hud.promptShown.includes('pad')", "timeout": 5000 },
  { "shot": "o04_pad_prompt" },
  { "key": "KeyE" },
  { "until": "!!G.scenes.ctx.flags.pad.active && G.controller.mode === 'table'", "timeout": 3000 },
  { "wait": 700 },
  { "expect": "G.hands.held.R && G.hands.held.R.userData.kind === 'pencil'", "label": "the pencil is in my right hand" },
  { "shot": "o05_pad_view" },
  { "mouse": "down" },
  { "eval": "[G.held('Mouse0'), G.scenes.ctx.flags.pad.press]" },
  { "look": [-160, -205], "steps": 6 },
  { "eval": "[G.held('Mouse0'), G.scenes.ctx.flags.pad.press, G.scenes.ctx.flags.pad.strokes]" },
  { "eval": "[+G.scenes.ctx.flags.pad.strokes.toFixed(3), G.scenes.ctx.flags.pad.uv(G.scenes.ctx.flags.pad.tip).map(v => +v.toFixed(3)), +N.controller.yaw.toFixed(2)]" },
  { "look": [220, 0], "steps": 8 },
  { "eval": "[+G.scenes.ctx.flags.pad.strokes.toFixed(3), G.scenes.ctx.flags.pad.uv(G.scenes.ctx.flags.pad.tip).map(v => +v.toFixed(3)), +N.controller.yaw.toFixed(2)]" },
  { "look": [-220, 25], "steps": 8 },
  { "look": [220, 25], "steps": 8 },
  { "look": [-220, 25], "steps": 8 },
  { "shot": "o06_rubbing" },
  { "look": [220, 25], "steps": 8 },
  { "look": [-220, 25], "steps": 8 },
  { "look": [220, 25], "steps": 8 },
  { "look": [-220, 25], "steps": 8 },
  { "look": [220, 25], "steps": 8 },
  { "look": [-220, 25], "steps": 8 },
  { "look": [220, -120], "steps": 8 },
  { "look": [-220, 30], "steps": 8 },
  { "look": [220, 30], "steps": 8 },
  { "look": [-220, 30], "steps": 8 },
  { "look": [220, 30], "steps": 8 },
  { "eval": "G.scenes.ctx.flags.pad.shown" },
  { "mouse": "up" },
  { "eval": "[G.scenes.ctx.flags.pad.solvedT, +G.scenes.ctx.flags.pad.shown.toFixed(2)]" },
  { "mouse": "down", "name": "(the third figure too: the sheet is only done when all three read)" },
  { "look": [-220, -60], "steps": 8 },
  { "look": [220, 20], "steps": 8 },
  { "look": [-220, 20], "steps": 8 },
  { "look": [220, 20], "steps": 8 },
  { "look": [-220, 20], "steps": 8 },
  { "look": [220, 20], "steps": 8 },
  { "look": [-220, 25], "steps": 8 },
  { "look": [220, 25], "steps": 8 },
  { "look": [-220, 25], "steps": 8 },
  { "look": [220, 25], "steps": 8 },
  { "mouse": "up" },
  { "until": "G.scenes.ctx.flags.pad.solvedT >= 0", "timeout": 3000 },
  { "wait": 700 },
  { "shot": "o07_numbers" },
  { "until": "G.scenes.ctx.flags.pad.done", "timeout": 5000 },
  { "wait": 700 },
  { "expect": "G.hands.held.L && G.hands.held.L.userData.kind === 'padSheet' && G.controller.mode !== 'table'", "label": "the sheet torn off into my left hand; the view back" },
  { "shot": "o08_sheet" },

  { "name": "4. the picture, the safe: right, left, right by the sheet" },
  { "look": [0, -260], "steps": 6 },
  { "walk": [[4.78, 2.6], [3.4, 1.9], [2.8, 2.1], [2.8, 0.95]], "timeout": 20000 },
  { "wait": 400 },
  { "eval": "[+N.controller.pitch.toFixed(2), +N.controller.yaw.toFixed(2), +G.eye.x.toFixed(2), +G.eye.z.toFixed(2), G.controller.mode]" },
  { "until": "G.hud.promptShown.includes('picture')", "timeout": 5000 },
  { "key": "KeyE" },
  { "wait": 1400 },
  { "shot": "o09_picture_aside" },
  { "until": "G.hud.promptShown.includes('dial')", "timeout": 5000 },
  { "key": "KeyE" },
  { "until": "!!G.scenes.ctx.flags.safe.active", "timeout": 3000 },
  { "wait": 900 },
  { "shot": "o10_dial" },
  { "look": [880, 0], "steps": 44 },
  { "wait": 400 },
  { "eval": "[G.scenes.ctx.flags.safe.reading.toFixed(1), G.scenes.ctx.flags.safe.stage, G.scenes.ctx.flags.safe.gate]" },
  { "look": [-1060, 0], "steps": 52 },
  { "wait": 400 },
  { "eval": "[G.scenes.ctx.flags.safe.reading.toFixed(1), G.scenes.ctx.flags.safe.stage, G.scenes.ctx.flags.safe.gate]" },
  { "look": [770, 0], "steps": 40 },
  { "wait": 900 },
  { "eval": "[G.scenes.ctx.flags.safe.reading.toFixed(1), G.scenes.ctx.flags.safe.stage, G.scenes.ctx.flags.safe.gate]" },
  { "until": "G.scenes.ctx.flags.safe.cracked", "timeout": 3000 },
  { "shot": "o11_cracked" },
  { "key": "KeyE" },
  { "until": "G.scenes.ctx.flags.safe.opened", "timeout": 5000 },
  { "wait": 600 },
  { "shot": "o12_safe_open" },

  { "name": "5. the ledger" },
  { "until": "G.scenes.beat === 'ledger' && G.hud.promptShown.includes('take')", "timeout": 5000 },
  { "key": "KeyE" },
  { "until": "!!G.inspect.active", "timeout": 3000 },
  { "wait": 1500 },
  { "look": [120, 40], "steps": 6 },
  { "shot": "o13_ledger" },
  { "key": "KeyE" },
  { "until": "G.save.inventory.includes('ledger')", "timeout": 4000 },
  { "until": "G.scenes.current.id === 'gunfight'", "timeout": 8000 },
  { "expect": "G.scenes.beat === 'shadows' && G.stage.name === 'office'", "label": "on into scene 5 in the same room" },
  { "wait": 1500 },
  { "shot": "o14_scene5_card" }
 ]
}
