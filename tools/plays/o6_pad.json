{
 "about": "[O6] The bed by the pad alone (the fake pad; the keyboard and the mouse never used): X on BEGIN; square at the coupe: in; R2 drives, the left stick onto the east kerb: the bed's things go over in front of it; L2 stops; square: out; R2 on foot: the Tommy gun fires (and what it hits answers). node tools/play.mjs tools/plays/o6_pad.json",
 "url": "/?mute=1&padfake=1&start=smash",
 "input": "pad",
 "size": [1280, 800],
 "out": "shots/o6/pad",
 "steps": [
  { "until": "G.state === 'title' && N.hud.titleShown", "timeout": 40000 },
  { "wait": 1500 },
  { "pad": { "b": ["x"], "secs": 0.12 }, "label": "the first press wakes the pad" },
  { "wait": 400 },
  { "pad": { "b": ["x"], "secs": 0.12 } },
  { "until": "G.scenes.current && G.scenes.current.id === 'smash' && !G.scenes.fadeK", "timeout": 45000 },
  { "wait": 1500 },
  { "pad": { "b": ["sq"], "secs": 0.15 } },
  { "until": "G.city.inCar && N.pad.context() === 'drive'", "timeout": 5000 },
  { "wait": 900 },
  { "eval": "(window.__s0 = G.stage.smash.stats.over + G.stage.smash.stats.broken, 1)" },
  { "pad": { "v": { "r2": 0.75 }, "hold": true } },
  { "wait": 1100 },
  { "pad": { "a": [0.55, 0, 0, 0], "secs": 0.35 } },
  { "wait": 3200 },
  { "expect": "G.stage.smash.stats.over + G.stage.smash.stats.broken > window.__s0", "label": "R2 and the stick: the bed's things go over in front of the car" },
  { "pad": { "v": { "r2": 0, "l2": 1 }, "hold": true } },
  { "until": "Math.abs(G.city.car.speed) < 0.5", "timeout": 6000 },
  { "pad": { "v": { "l2": 0 } } },
  { "wait": 900 },
  { "pad": { "b": ["sq"], "secs": 0.15 } },
  { "until": "!G.city.inCar", "timeout": 4000 },
  { "wait": 1200 },
  { "eval": "(window.__sh = G.counters.shots, 1)" },
  { "pad": { "v": { "r2": 1 }, "hold": true } },
  { "wait": 450 },
  { "pad": { "v": { "r2": 0 } } },
  { "wait": 300 },
  { "expect": "G.counters.shots > window.__sh && G.hands.set === 'tommy'", "label": "out of the car the Tommy gun is in my hands again; R2 fires it" }
 ]
}
