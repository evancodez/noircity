{
 "about": "[O4] The gym (tools/lib/o4_brawl.mjs, the bout taken up with E at the ring). Hands off: Kid Leary puts me down, warned; the bet is his.",
 "url": "/?mute=1&o4stay=1&start=o4.gym",
 "size": [
  1280,
  800
 ],
 "out": "shots/play/gym_idle",
 "steps": [
  {
   "until": "G.state === 'title' && !!document.querySelector('#title .opt[data-k=begin]')",
   "timeout": 60000
  },
  {
   "wait": 1200
  },
  {
   "clickOn": "#title .opt[data-k=begin]",
   "taken": "G.scenes.current && G.scenes.current.id === 'o4'",
   "retries": 4
  },
  {
   "until": "G.scenes.current && G.scenes.current.id === 'o4' && G.scenes.beat === 'gym' && !G.failing",
   "timeout": 30000
  },
  {
   "eval": "(G.o4stay = true)"
  },
  {
   "drive": "tools/lib/o4_brawl.mjs",
   "profile": "idle",
   "beat": "gym",
   "tries": 1,
   "wins": 1,
   "timeout": 150000,
   "check": "D.losses >= 1 && D.wins === 0",
   "label": "a bout, hands off: down, warned",
   "startKey": "KeyE"
  }
 ]
}