 "size": [
  1280,
  800
 ],
 "out": "shots/play/1v3_bad",
 "steps": [
  {
   "until": "G.state === 'title' && !!document.querySelector('#title .opt[data-k=begin]')",
   "timeout": 60000
  },
  {
   "wait": 1200
  },
  {
   "clickOn": "#title .opt[data-k=begin]",
   "taken": "G.scenes.current && G.scenes.current.id === 'o4'",
   "retries": 4
  },
  {
   "until": "G.scenes.current && G.scenes.current.id === 'o4' && G.scenes.beat === 'brawl3' && G.crowd.active && !G.failing",
   "timeout": 30000
  },
  {
   "eval": "(G.o4stay = true)"
  },
  {
   "drive": "tools/lib/o4_brawl.mjs",
   "profile": "bad",
   "beat": "brawl3",
   "tries": 4,
   "wins": 1,
   "timeout": 480000,
   "check": "D.wins >= 1",
   "label": "1v3 clumsy hands get through within four tries"
  }
 ]
}