{
 "about": "[O4] The crowd brawl on the street (tools/lib/o4_brawl.mjs). 1v1: medium hands win within one to three tries.",
 "url": "/?mute=1&o4stay=1&start=o4.brawl1",
 "size": [
  1280,
  800
 ],
 "out": "shots/play/1v1_medium",
 "steps": [
  {
   "until": "G.state === 'title' && !!document.querySelector('#title .opt[data-k=begin]')",
   "timeout": 60000
  },
  {
   "wait": 1200
  },
  {
   "clickOn": "#title .opt[data-k=begin]",
   "taken": "G.scenes.current && G.scenes.current.id === 'o4'",
   "retries": 4
  },
  {
   "until": "G.scenes.current && G.scenes.current.id === 'o4' && G.scenes.beat === 'brawl1' && G.crowd.active && !G.failing",
   "timeout": 30000
  },
  {
   "eval": "(G.o4stay = true)"
  },
  {
   "drive": "tools/lib/o4_brawl.mjs",
   "profile": "medium",
   "beat": "brawl1",
   "tries": 3,
   "wins": 1,
   "timeout": 420000,
   "check": "D.wins >= 1",
   "label": "1v1 medium hands get through within three tries"
  }
 ]
}